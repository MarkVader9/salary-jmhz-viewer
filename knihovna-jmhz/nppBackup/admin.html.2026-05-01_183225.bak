<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SALARY - Administrace Knihovny (Enterprise)</title>
    
    <script src="https://cdn.ckeditor.com/ckeditor5/41.2.1/classic/ckeditor.js"></script>

    <style>
        :root {
            --bg-base: oklch(97% 0.005 250);
            --bg-surface: oklch(99% 0.003 250);
            --border: oklch(87% 0.012 250);
            --text-primary: oklch(20% 0.02 250);
            --text-muted: oklch(50% 0.01 250);
            --accent: oklch(50.48% 0.177 261.64);
            --accent-soft: oklch(94% 0.035 255);
            --danger: #ef4444;
            --success: #10b981;
            --warning: #f59e0b;
            --radius: 8px;
        }

        body { font-family: system-ui, sans-serif; background: var(--bg-base); color: var(--text-primary); margin: 0; height: 100vh; overflow: hidden; }

        .admin-grid { display: grid; grid-template-columns: 280px 1fr 300px; height: 100vh; }
        .panel { background: var(--bg-surface); display: flex; flex-direction: column; overflow-y: auto; }
        .border-r { border-right: 1px solid var(--border); }
        .border-l { border-left: 1px solid var(--border); }

        .panel-header { padding: 20px; border-bottom: 1px solid var(--border); background: var(--bg-surface); position: sticky; top: 0; z-index: 10;}
        .article-list { padding: 10px; flex-grow: 1; }
        .article-item { padding: 12px 15px; border-radius: var(--radius); border: 1px solid transparent; cursor: pointer; margin-bottom: 5px; transition: 0.2s; position: relative; background: transparent;}
        .article-item:hover { background: var(--bg-base); }
        .article-item.active { background: var(--accent-soft); border-color: var(--accent); }
        .article-item-title { font-size: 0.9rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #111827;}
        .article-item-status { font-size: 0.75rem; font-weight: 600; margin-top: 4px; }
        .status-tag-pub { color: var(--success); }
        .status-tag-priv { color: var(--text-muted); }
        .del-btn { position: absolute; right: 10px; top: 12px; display: none; color: var(--danger); cursor: pointer; padding: 4px;}
        .article-item:hover .del-btn { display: block; }

        .editor-container { background: var(--bg-base); overflow-y: auto; padding: 40px; display: flex; flex-direction: column; align-items: center; position: relative;}
        .editor-canvas { width: 100%; max-width: 900px; background: white; padding: 50px; border-radius: var(--radius); box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); display: flex; flex-direction: column; min-height: max-content; }
        
        .title-input { width: 100%; border: none; font-size: 2.2rem; font-weight: 800; outline: none; margin-bottom: 20px; color: #111827; background: transparent; letter-spacing: -0.02em;}
        .title-input::placeholder { color: #cbd5e1; }
        
        .ck-editor__editable { min-height: 50vh !important; border: 1px solid transparent !important; box-shadow: none !important; padding: 0 !important; font-size: 1.1rem; line-height: 1.6; color: #374151;}
        .ck.ck-editor__main>.ck-editor__editable:not(.ck-focused) { border: 1px solid transparent !important; }
        .ck-toolbar { border: none !important; border-bottom: 1px solid var(--border) !important; background: white !important; position: sticky; top: -50px; z-index: 10; padding: 10px 0 !important; margin-bottom: 20px !important;}

        .editor-footer { margin-top: auto; padding-top: 30px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
        
        .side-group { margin-bottom: 30px; }
        .side-label { font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: var(--text-muted); display: block; margin-bottom: 10px; letter-spacing: 0.05em;}
        select, .cat-input { width: 100%; padding: 12px; border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: 10px; background: white; font-size: 0.9rem; outline: none; box-sizing: border-box;}
        select:focus, .cat-input:focus { border-color: var(--accent); }
        
        .btn-main { background: var(--accent); color: white; border: none; padding: 12px 20px; border-radius: var(--radius); cursor: pointer; font-weight: 600; font-size: 0.95rem; transition: 0.2s; white-space: nowrap;}
        .btn-save { background: white; color: var(--accent); border: 1px solid var(--accent); }
        .btn-main:hover { transform: translateY(-1px); box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .btn-save:hover { background: var(--bg-base); box-shadow: none; transform: none;}

        .tags-box { border: 1px solid var(--border); border-radius: var(--radius); padding: 8px; display: flex; flex-wrap: wrap; gap: 6px; background: white; }
        .tag-pill { background: var(--accent-soft); color: var(--accent); padding: 4px 10px; border-radius: 12px; font-size: 0.8rem; font-weight: 600; display: flex; align-items: center; gap: 6px; }
        .tag-pill span { cursor: pointer; opacity: 0.7; }
        .tag-pill span:hover { opacity: 1; }
        .tag-field { border: none; outline: none; padding: 4px; flex-grow: 1; font-size: 0.9rem; min-width: 100px;}

        .progress-container { position: sticky; bottom: 0; background: var(--bg-surface); padding: 20px; border-top: 1px solid var(--border); display: none; }
        .progress-track { width: 100%; background: #e5e7eb; border-radius: 4px; height: 6px; overflow: hidden; margin-top: 8px; }
        .progress-fill { width: 0%; height: 100%; background: var(--accent); transition: width 0.1s linear; }

        #unsavedIndicator { display: none; width: 8px; height: 8px; background: var(--accent); border-radius: 50%; margin-left: auto;}
        
        @keyframes blink-warning { 0% { opacity: 1; } 50% { opacity: 0.2; } 100% { opacity: 1; } }
        .status-blinking { animation: blink-warning 1s infinite; color: var(--danger) !important; }
        .status-offline { color: var(--warning) !important; font-weight: 800; }
    </style>
</head>
<body>

<div class="admin-grid">
    <aside class="panel border-r">
        <div class="panel-header"><button class="btn-main" onclick="createNewArticle()" style="width: 100%;">Napsat nový článek</button></div>
        <div class="article-list" id="articleList"></div>
    </aside>

    <main class="editor-container">
        <div class="editor-canvas">
            <div style="display: flex; justify-content: space-between; margin-bottom: 30px; align-items: center;">
                <span style="font-weight: 800; color: var(--accent); font-size: 0.85rem; letter-spacing: 0.05em;">EDITOR ČLÁNKŮ</span>
                <div style="display: flex; align-items: center; gap: 10px;">
                    <div id="unsavedIndicator" title="Máte neuložené změny"></div>
                    <span id="saveStatus" style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted);">Připojování k databázi...</span>
                </div>
            </div>
            
            <input type="text" id="articleTitle" class="title-input" placeholder="Zadejte nadpis článku...">
            <div id="editor"></div>

            <div class="editor-footer">
                <span style="font-size: 0.8rem; color: var(--text-muted);">Změny se automaticky ukládají. Klávesová zkratka: Ctrl+S</span>
                <div style="display: flex; gap: 10px;">
                    <button class="btn-main btn-save" onclick="manualSave()" id="btnSave">Uložit nanečisto</button>
                    <div style="display: flex; border: 1px solid var(--accent); border-radius: var(--radius); overflow: hidden; background: white;">
                        <select id="publishStatus" style="margin:0; border:none; padding: 0 15px; font-weight: 700; color: var(--accent); cursor: pointer;" onchange="markDirty()">
                            <option value="private">🔒 Skryto v archivu</option>
                            <option value="public">🌐 Veřejně viditelné</option>
                        </select>
                        <button class="btn-main" onclick="publishArticle()" style="border-radius:0; border:none;" id="btnPublish">Aplikovat status</button>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <aside class="panel border-l" style="justify-content: space-between;">
        <div style="padding: 20px;">
            <div class="side-group">
                <span class="side-label">Kategorie</span>
                <select id="articleCategory" onchange="markDirty()"><option value="">-- Bez zařazení --</option></select>
            </div>
            <div class="side-group">
                <span class="side-label">Klíčová slova (Tagy)</span>
                <div class="tags-box" id="tagsBox"><input type="text" id="tagInput" class="tag-field" placeholder="Napište a stiskněte Tab"></div>
            </div>
            <div class="side-group" style="background: var(--bg-base); padding: 20px; border-radius: var(--radius); border: 1px dashed var(--border);">
                <span class="side-label">Založit novou kategorii</span>
                <input type="text" id="newCatName" class="cat-input" placeholder="Název kategorie">
                <select id="newCatParent" class="cat-input"><option value="null">-- Bez nadřazené --</option></select>
                <button class="btn-main btn-save" onclick="createNewCategory()" style="width: 100%;">Přidat do systému</button>
            </div>
        </div>

        <div class="progress-container" id="progressBox">
            <span class="side-label" id="progressLabel" style="color: var(--accent);">Nahrávání na server...</span>
            <div class="progress-track"><div class="progress-fill" id="progressBar"></div></div>
        </div>
    </aside>
</div>

<script>
    let dbData = { categories: [], articles: [] };
    let currentId = null;
    let tags = [];
    let editorObj = null;
    let isDbReady = false; 
    let isSwitching = false;
    let isDirty = false;
    let autoSaveTimer;

    const LOCAL_BACKUP_KEY = 'jmhz_kb_offline_backup';

    // --- 1. BOOTSTRAP A OFFLINE DETEKCE ---
    document.addEventListener('DOMContentLoaded', initApp);
    document.addEventListener('keydown', e => { if ((e.ctrlKey || e.metaKey) && e.key === 's') { e.preventDefault(); manualSave(); } });
    
    window.addEventListener('beforeunload', (e) => { if (isDirty) { e.preventDefault(); e.returnValue = ''; } });

    window.addEventListener('offline', () => updateNetworkStatus());
    window.addEventListener('online', () => {
        updateNetworkStatus();
        if (localStorage.getItem(LOCAL_BACKUP_KEY)) executeSave(true);
    });

    function updateNetworkStatus() {
        const statusEl = document.getElementById('saveStatus');
        if (!navigator.onLine) {
            statusEl.textContent = "⚠ Jste Offline (Zálohuji lokálně)";
            statusEl.classList.add('status-offline');
        } else {
            statusEl.classList.remove('status-offline');
            if (!isDirty) statusEl.textContent = "Vše aktuální (Online)";
        }
    }

    async function initApp() {
        try {
            const editor = await ClassicEditor.create(document.querySelector('#editor'), {
                toolbar: ['heading', '|', 'bold', 'italic', 'link', 'bulletedList', 'numberedList', 'blockQuote', 'insertTable', 'undo', 'redo'],
                placeholder: 'Sem začněte psát článek, nebo vložte text zkopírovaný z Microsoft Word...',
            });
            editorObj = editor;
            editorObj.model.document.on('change:data', () => { if(!isSwitching) markDirty(); });
            
            await fetchDatabase();
        } catch (e) {
            const statusEl = document.getElementById('saveStatus');
            statusEl.textContent = "Kritická chyba editoru";
            statusEl.classList.add('status-blinking');
        }
    }

    async function fetchDatabase() {
        try {
            const res = await fetch('data/api.php');
            const data = await res.json();
            if (data.categories) { dbData = data; isDbReady = true; }
        } catch (e) { 
            const statusEl = document.getElementById('saveStatus');
            statusEl.textContent = "⚠ FTP nedostupné";
            statusEl.classList.add('status-blinking');
            
            const localBackup = localStorage.getItem(LOCAL_BACKUP_KEY);
            if (localBackup) {
                dbData = JSON.parse(localBackup);
                isDbReady = true;
                statusEl.textContent = "⚠ Offline režim (Načtena lokální data)";
                statusEl.classList.remove('status-blinking');
                statusEl.classList.add('status-offline');
            } else {
                return;
            }
        }

        renderCategories();
        renderSidebarList();

        if (dbData.articles.length > 0) {
            const latest = [...dbData.articles].sort((a,b) => new Date(b.lastUpdated) - new Date(a.lastUpdated))[0];
            openArticle(latest.id);
        } else {
            createNewArticle();
        }
        
        if (navigator.onLine && isDbReady) {
            const statusEl = document.getElementById('saveStatus');
            statusEl.classList.remove('status-blinking');
            statusEl.textContent = "Vše aktuální";
        }
    }

    // --- 2. ENGINE ---
    function markDirty() {
        if(isSwitching) return;
        isDirty = true;
        document.getElementById('unsavedIndicator').style.display = 'block';
        if(navigator.onLine) {
            document.getElementById('saveStatus').textContent = "Neuložené změny...";
        }
        
        clearTimeout(autoSaveTimer);
        autoSaveTimer = setTimeout(() => executeSave(false), 2500);
    }

    function clearDirty() {
        isDirty = false;
        document.getElementById('unsavedIndicator').style.display = 'none';
        updateNetworkStatus();
    }

    function openArticle(id) {
        if (!isDbReady) return;
        if (isDirty && navigator.onLine && !confirm("Máte neuložené změny. Opravdu chcete přejít na jiný článek?")) return;

        isSwitching = true;
        const art = dbData.articles.find(a => a.id === id);
        currentId = id;
        
        document.getElementById('articleTitle').value = art.title || '';
        document.getElementById('articleCategory').value = art.categoryId || '';
        document.getElementById('publishStatus').value = art.status || 'private';
        tags = [...(art.tags || [])];
        renderTagPills();

        let safeContent = '';
        if (typeof art.content === 'string') {
            safeContent = art.content;
        } else if (art.content && typeof art.content === 'object') {
            safeContent = '<p><em>Upozornění: Tento článek obsahuje starý formát dat, který byl vyčištěn.</em></p>';
        }
        
        editorObj.setData(safeContent);
        
        isSwitching = false;
        clearDirty();
        renderSidebarList();
    }

    function createNewArticle() {
        if (isDirty && navigator.onLine && !confirm("Máte neuložené změny. Pokračovat?")) return;
        isSwitching = true;
        currentId = 'art_' + Date.now();
        
        document.getElementById('articleTitle').value = '';
        document.getElementById('articleCategory').value = '';
        document.getElementById('publishStatus').value = 'private';
        tags = [];
        renderTagPills();
        editorObj.setData('');
        
        isSwitching = false;
        clearDirty();
        renderSidebarList();
    }

    // --- 3. UPLOAD / LOCALSTORAGE ---
    function manualSave() { executeSave(true); }

    async function publishArticle() {
        if(!navigator.onLine) {
            alert("Pro publikaci musíte být připojeni k internetu. Práce je uložena v prohlížeči.");
            return;
        }
        await executeSave(true);
        const status = document.getElementById('publishStatus').value;
        alert(status === 'public' ? "Článek je nyní online pro veřejnost!" : "Článek byl úspěšně skryt.");
    }

    function executeSave(isManual) {
        return new Promise((resolve) => {
            if (!isDbReady || isSwitching || !isDirty) return resolve();
            clearTimeout(autoSaveTimer);

            let idx = dbData.articles.findIndex(a => a.id === currentId);
            const content = editorObj.getData();
            const dataObj = {
                id: currentId,
                title: document.getElementById('articleTitle').value.trim() || 'Nový článek',
                categoryId: document.getElementById('articleCategory').value,
                tags: tags,
                content: content,
                status: document.getElementById('publishStatus').value,
                lastUpdated: new Date().toISOString(),
                readingTimeMin: Math.max(1, Math.ceil(content.length / 1200))
            };

            if (idx > -1) dbData.articles[idx] = dataObj;
            else dbData.articles.push(dataObj);

            renderSidebarList();
            localStorage.setItem(LOCAL_BACKUP_KEY, JSON.stringify(dbData));

            if (!navigator.onLine) {
                clearDirty();
                return resolve();
            }

            const xhr = new XMLHttpRequest();
            xhr.open('POST', 'data/api.php', true);
            xhr.setRequestHeader('Content-Type', 'application/json');

            const pBox = document.getElementById('progressBox');
            const pBar = document.getElementById('progressBar');
            const pLbl = document.getElementById('progressLabel');
            
            pBox.style.display = 'block';
            pBar.style.width = '0%';
            pBar.style.background = 'var(--accent)';
            pLbl.textContent = 'Odesílání...';
            pLbl.style.color = 'var(--accent)';

            document.getElementById('btnSave').disabled = true;

            xhr.upload.onprogress = (e) => {
                if(e.lengthComputable) pBar.style.width = Math.round((e.loaded / e.total) * 100) + '%';
            };

            xhr.onload = () => {
                document.getElementById('btnSave').disabled = false;
                if (xhr.status === 200) {
                    pBar.style.background = 'var(--success)';
                    pLbl.textContent = '✓ Zapsáno na server';
                    pLbl.style.color = 'var(--success)';
                    clearDirty();
                    localStorage.removeItem(LOCAL_BACKUP_KEY);
                    setTimeout(() => pBox.style.display = 'none', 1500);
                } else {
                    pBar.style.background = 'var(--danger)';
                    pLbl.textContent = '⚠ Chyba FTP zápisu (Uloženo lokálně)';
                    pLbl.style.color = 'var(--danger)';
                    clearDirty();
                }
                resolve();
            };

            xhr.onerror = () => {
                document.getElementById('btnSave').disabled = false;
                pBar.style.background = 'var(--warning)';
                pLbl.textContent = '⚠ Ztráta sítě (Uloženo v prohlížeči)';
                pLbl.style.color = 'var(--warning)';
                clearDirty();
                resolve();
            };

            // Odeslání tokenu i dat
            xhr.send(JSON.stringify({ token: "SuperTajneHesloSalary2026", dbData: dbData }));
        });
    }

    // --- 4. UTILS ---
    document.getElementById('articleTitle').addEventListener('input', markDirty);

    function renderSidebarList() {
        const list = document.getElementById('articleList');
        list.innerHTML = '';
        [...dbData.articles].sort((a,b) => new Date(b.lastUpdated) - new Date(a.lastUpdated)).forEach(art => {
            const isPub = art.status === 'public';
            const item = document.createElement('div');
            item.className = `article-item ${art.id === currentId ? 'active' : ''}`;
            item.innerHTML = `<div onclick="openArticle('${art.id}')"><div class="article-item-title">${art.title}</div><div class="article-item-status ${isPub?'status-tag-pub':'status-tag-priv'}">${isPub?'🌐 Publikováno':'🔒 Soukromé'}</div></div><span class="del-btn" onclick="deleteArticle('${art.id}', event)">🗑️</span>`;
            list.appendChild(item);
        });
    }

    function deleteArticle(id, e) {
        e.stopPropagation();
        if (confirm("Chystáte se smazat článek. Tato akce je nevratná!")) {
            dbData.articles = dbData.articles.filter(a => a.id !== id);
            if (currentId === id) createNewArticle();
            else { renderSidebarList(); markDirty(); executeSave(true); }
        }
    }

    function renderCategories() {
        let h = '';
        const build = (pId = null, pref = "") => {
            dbData.categories.filter(c => c.parentId === pId).forEach(c => {
                h += `<option value="${c.id}">${pref}${c.name}</option>`; build(c.id, pref + "— ");
            });
        };
        build();
        document.getElementById('articleCategory').innerHTML = '<option value="">-- Nezařazeno --</option>' + h;
        document.getElementById('newCatParent').innerHTML = '<option value="null">-- Hlavní úroveň --</option>' + h;
    }

    function createNewCategory() {
        const n = document.getElementById('newCatName').value.trim();
        const p = document.getElementById('newCatParent').value === "null" ? null : document.getElementById('newCatParent').value;
        if (!n) return;
        dbData.categories.push({ id: 'cat_' + Date.now(), name: n, parentId: p });
        document.getElementById('newCatName').value = '';
        renderCategories();
        markDirty();
        executeSave(true);
    }

    const tagInput = document.getElementById('tagInput');
    tagInput.addEventListener('keydown', e => { if (e.key === 'Tab' || e.key === 'Enter') { e.preventDefault(); const val = tagInput.value.trim(); if (val && !tags.includes(val)) { tags.push(val); tagInput.value=''; renderTagPills(); markDirty(); } } });
    
    function renderTagPills() { 
        document.querySelectorAll('.tag-pill').forEach(el => el.remove()); 
        tags.forEach((t, i) => { 
            const p = document.createElement('div'); 
            p.className='tag-pill'; 
            p.innerHTML=`${t} <span onclick="tags.splice(${i}, 1); renderTagPills(); markDirty();">&times;</span>`; 
            document.getElementById('tagsBox').insertBefore(p, tagInput); 
        }); 
    }
</script>
</body>
</html>