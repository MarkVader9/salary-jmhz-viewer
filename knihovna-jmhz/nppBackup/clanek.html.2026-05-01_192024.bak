<!DOCTYPE html>
<html lang="cs" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Čtení článku - SALARY KB</title>
    <style>
        :root {
            --bg-base: oklch(97% 0.005 250); 
            --bg-surface: oklch(99% 0.003 250); 
            --border: oklch(87% 0.012 250);
            --text-primary: oklch(20% 0.02 250);
            --text-secondary: oklch(42% 0.015 250);
            --text-muted: oklch(58% 0.012 250);
            --accent: oklch(50.48% 0.177 261.64);
            --radius-lg: 8px;
        }

        body { font-family: system-ui, -apple-system, sans-serif; background: var(--bg-base); color: var(--text-primary); margin: 0; padding: 0; line-height: 1.7; scroll-behavior: smooth;}

        .progress-bar-container { position: fixed; top: 0; left: 0; width: 100%; height: 4px; background: rgba(0,0,0,0.05); z-index: 9999; }
        .progress-bar { height: 100%; background: var(--accent); width: 0%; transition: width 0.15s ease-out; }

        .article-header { background: var(--bg-surface); border-bottom: 1px solid var(--border); padding: 15px 40px; display: flex; align-items: center; position: sticky; top: 0; z-index: 1000; box-shadow: 0 1px 2px rgba(0,0,0,0.02);}
        .back-btn { text-decoration: none; color: var(--text-secondary); font-size: 0.95rem; font-weight: 600; display: flex; align-items: center; gap: 8px; transition: 0.2s;}
        .back-btn:hover { color: var(--accent); transform: translateX(-3px);}

        .layout { display: grid; grid-template-columns: 260px 1fr 320px; max-width: 1500px; margin: 0 auto; gap: 30px; padding: 40px 20px; align-items: start;}

        .toc-aside { position: sticky; top: 100px; max-height: calc(100vh - 120px); overflow-y: auto; padding-right: 10px;}
        .toc-title { font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: var(--text-muted); margin-bottom: 15px; letter-spacing: 0.05em; }
        .toc-link { display: block; padding: 8px 12px; font-size: 0.9rem; color: var(--text-secondary); text-decoration: none; border-left: 2px solid transparent; transition: all 0.2s; border-radius: 0 6px 6px 0; line-height: 1.3;}
        .toc-link:hover { color: var(--accent); background: oklch(96% 0.01 250); }
        .toc-link.active { border-left-color: var(--accent); color: var(--accent); font-weight: 700; background: oklch(98% 0.005 250);}
        .toc-level-3 { margin-left: 15px; font-size: 0.85rem; }
        .toc-level-4 { margin-left: 30px; font-size: 0.8rem; }

        .article-card { background: white; border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 50px 60px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); }
        .article-title { font-size: 2.5rem; font-weight: 800; margin: 0 0 20px 0; color: #111827; line-height: 1.2; letter-spacing: -0.02em;}
        
        .editor-content p { margin-bottom: 1.2em; font-size: 1.1rem; color: #374151;}
        .editor-content h2 { font-size: 1.8rem; font-weight: 700; margin-top: 2em; margin-bottom: 0.8em; color: #111827; scroll-margin-top: 90px;}
        .editor-content h3 { font-size: 1.4rem; font-weight: 700; margin-top: 1.5em; margin-bottom: 0.8em; color: #1f2937; scroll-margin-top: 90px;}
        .editor-content ul, .editor-content ol { margin-bottom: 1.2em; padding-left: 25px; font-size: 1.1rem; color: #374151;}
        .editor-content li { margin-bottom: 0.5em; }
        .editor-content a { color: var(--accent); text-decoration: none; font-weight: 500;}
        .editor-content a:hover { text-decoration: underline; }
        .editor-content blockquote { border-left: 4px solid var(--accent); margin: 1.5em 0; padding: 10px 20px; background: oklch(98% 0.005 250); font-style: italic; color: var(--text-secondary); border-radius: 0 8px 8px 0;}
        .editor-content table { width: 100%; border-collapse: collapse; margin-bottom: 1.5em; font-size: 0.95rem;}
        .editor-content th { background: var(--bg-base); font-weight: 600; text-align: left; }
        .editor-content th, .editor-content td { border: 1px solid var(--border); padding: 12px 16px; }

        .info-sidebar { position: sticky; top: 100px; background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 24px; }
        .sidebar-block { margin-bottom: 25px; }
        .sidebar-block:last-child { margin-bottom: 0; }
        .sidebar-label { font-size: 0.75rem; text-transform: uppercase; font-weight: 800; color: var(--text-muted); display: block; margin-bottom: 10px; letter-spacing: 0.05em;}
        .sidebar-value { font-size: 0.95rem; font-weight: 500; color: var(--text-primary); line-height: 1.6;}
        .tag-pill { display: inline-block; background: oklch(95% 0.02 260); color: var(--accent); padding: 4px 12px; border-radius: 12px; font-size: 0.8rem; font-weight: 600; margin: 0 6px 6px 0; }
        .btn-print { width: 100%; padding: 12px; cursor: pointer; border: 1px solid var(--border); border-radius: 6px; background: white; font-size: 0.9rem; font-weight: 600; color: var(--text-primary); transition: 0.2s; display: flex; justify-content: center; align-items: center; gap: 8px;}
        .btn-print:hover { background: var(--bg-base); border-color: var(--text-muted);}

        @media print {
            body { background: white; color: black; }
            .article-header, .toc-aside, .info-sidebar, .progress-bar-container { display: none !important; }
            .layout { display: block; padding: 0; margin: 0; max-width: 100%; }
            .article-card { border: none; box-shadow: none; padding: 0; }
            .editor-content a { color: black; text-decoration: underline; }
            @page { margin: 2cm; }
        }

        @media (max-width: 1200px) { .layout { grid-template-columns: 1fr 300px; } .toc-aside { display: none; } }
        @media (max-width: 900px) { .layout { grid-template-columns: 1fr; padding: 20px 10px;} .info-sidebar { display: none; } .article-card{ padding: 30px 20px;} }
    </style>
</head>
<body>

    <div class="progress-bar-container"><div class="progress-bar" id="progressBar"></div></div>

    <header class="article-header">
        <a href="index.html" class="back-btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            Zpět do knihovny
        </a>
    </header>

    <div id="loader" style="text-align: center; padding: 100px; color: var(--text-muted);">Načítám dokument...</div>

    <div class="layout" id="layoutContainer" style="display: none;">
        <aside class="toc-aside">
            <div class="toc-title">V tomto článku</div>
            <nav id="tocList"></nav>
        </aside>

        <main>
            <article class="article-card">
                <h1 class="article-title" id="articleTitle"></h1>
                <div id="articleContent" class="editor-content"></div>
            </article>
        </main>

        <aside class="info-sidebar">
            <div class="sidebar-block">
                <span class="sidebar-label">Informace</span>
                <div id="articleMeta" class="sidebar-value"></div>
            </div>
            <div class="sidebar-block">
                <span class="sidebar-label">Štítky</span>
                <div id="articleTags"></div>
            </div>
            <div class="sidebar-block">
                <span class="sidebar-label">Nástroje</span>
                <button class="btn-print" onclick="window.print()">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                    Vytisknout článek
                </button>
            </div>
        </aside>
    </div>

<script>
    const urlParams = new URLSearchParams(window.location.search);
    const articleId = urlParams.get('id');

    async function loadArticle() {
        if (!articleId) return location.href = 'index.html';
        try {
            // ENTERPRISE OPRAVA 1: Změna endpointu pro potlačení Cache problému
            const res = await fetch('data/api.php');
            const db = await res.json();
            const article = db.articles.find(a => a.id === articleId && a.status === 'public');
            
            if (!article) {
                document.getElementById('loader').innerHTML = '<h2>Článek nenalezen</h2><p>Tento článek neexistuje nebo byl nastaven jako soukromý.</p><a href="index.html">Zpět na hlavní stranu</a>';
                return;
            }
            renderArticle(article);
        } catch (e) { document.getElementById('loader').textContent = 'Chyba serveru.'; }
    }

    function renderArticle(article) {
        document.title = `${article.title} - SALARY KB`;
        document.getElementById('loader').style.display = 'none';
        document.getElementById('layoutContainer').style.display = 'grid';

        document.getElementById('articleTitle').textContent = article.title;
        document.getElementById('articleMeta').innerHTML = `Aktualizováno:<br><strong>${new Date(article.lastUpdated).toLocaleDateString('cs-CZ')}</strong><br><br>Odhadovaný čas:<br><strong>${article.readingTimeMin} min čtení</strong>`;
        
        // Zabezpečení proti vadným datům starých editorů
        if (typeof article.content === 'string') {
            document.getElementById('articleContent').innerHTML = article.content;
        } else {
            document.getElementById('articleContent').innerHTML = '<p><em>Tento článek je prázdný.</em></p>';
        }

        document.getElementById('articleTags').innerHTML = (article.tags || []).map(t => `<span class="tag-pill">${t}</span>`).join('');

        // Generování obsahu (TOC)
        const headings = document.getElementById('articleContent').querySelectorAll('h2, h3');
        let tocHtml = '';
        headings.forEach((h, index) => {
            const id = `sec-${index}`;
            h.id = id;
            const level = h.tagName.toLowerCase().replace('h', '');
            tocHtml += `<a href="#${id}" class="toc-link toc-level-${level}" data-target="${id}">${h.textContent}</a>`;
        });

        if (headings.length > 0) {
            document.getElementById('tocList').innerHTML = tocHtml;
            initEnterpriseScrollSpy(headings);
        } else {
            document.querySelector('.toc-aside').style.display = 'none';
        }

        // Reading Progress Bar
        window.addEventListener('scroll', () => {
            const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
            const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            document.getElementById('progressBar').style.width = (winScroll / height) * 100 + "%";
        }, { passive: true });
    }

    function initEnterpriseScrollSpy(headings) {
        const tocLinks = document.querySelectorAll('.toc-link');
        const observerOptions = { root: null, rootMargin: '0px 0px -80% 0px', threshold: 1.0 };
        
        let activeId = null;

        const observer = new IntersectionObserver(entries => {
            entries.forEach(entry => {
                if (entry.isIntersecting) activeId = entry.target.id;
            });
            
            if(activeId) {
                tocLinks.forEach(link => {
                    link.classList.toggle('active', link.getAttribute('data-target') === activeId);
                });
            }
        }, observerOptions);

        headings.forEach(h => observer.observe(h));
    }

    document.addEventListener('DOMContentLoaded', loadArticle);
</script>
</body>
</html>