  // 10507-10511 (cdr.* / KONTAKT): address completeness — OVERLAP_WITH_R33-R37+R152
  // 10095,10098,10097 (forin.num/pnu/cit / CIZO): address completeness — OVERLAP_WITH_R83-R86

  // ── INDIRECTLY COVERED (chaining through parent field checks) ──
  // 10087 (healtrest.to): P=10085 filled; R208 covers 10086→parent, R115 chains fro→to — INDIRECT_VIA_R208+R115
  // 10110 (nocitizen.permto): P=10106 filled; R207 covers 10109→parent, R122 chains fro→to — INDIRECT_VIA_R207+R122

  // ── FIELD MISSING from formats.js ──
  // 10258 (job.place): P depends on field 10211 (not in REGZEC_CONFIG) — FIELD_MISSING
  // 10396 (attachs.attach.name): not in REGZEC_CONFIG mirror — COVERED_BY_R127 (DOM-based check)
  // 10400 (attachs.attach.data): not in REGZEC_CONFIG mirror — COVERED_BY_R127 (DOM-based check)

  // ── N-ONLY (no P or Z to enforce) ──
  // 10092 (forin.cur) for N column: N="10239 <> N" → makes field optional. P-side merged into R157.

  // ── Main Entry Point ─────────────────────────────────────────

  function runKontroly(xmlDoc, employees, headerFields, fields, fieldsBySec, fieldRules) {
    buildCsszIndex(fields);
    _sqnrCounts = null;
    _fieldRules = fieldRules || null;

    var results = [];

    KONTROLY.forEach(function (rule) {
      employees.forEach(function (emp, empIdx) {
        var errs = evalRule(rule, emp, headerFields, employees);
        errs.forEach(function (e) {
          var fd = getFieldDef(e.fieldCsszId);
          var fk = fd ? fieldKeyFor(fd, e.instanceIndex) : '';
          results.push({
            severity: e.severity, controlId: e.controlId,
            empIndex: empIdx,
            employeeName: emp.surname ? (emp.surname + ' ' + (emp.firstName || '')).trim() : ('Řádek ' + (empIdx + 1)),
            sectionLabel: getSectionLabel(e.fieldCsszId),
            fieldLabel: getFieldLabel(e.fieldCsszId),
            fieldKey: fk, headerKey: '',
            canNavigate: !!fd, message: e.message
          });
        });
      });
    });

    return results;
  }

  // Reset index on format change
  function resetKontrolyIndex() {
    KU.resetKontrolyIndex();
  }

  // ── Export ────────────────────────────────────────────────────
  window.REGZECKontroly = {
    runKontroly: runKontroly,
    resetKontrolyIndex: resetKontrolyIndex,
    KONTROLY: KONTROLY
  };
})();
