    // R119: nocitizen.issue — if 10106=1 (Povolení k zaměstnání) → mandatory
    { id: 'R119', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Krajská pobočka ÚP: povinná.',
      check: function(ctx) {
        if (ctx.getVal('10106') === '1' && !ctx.isFilled('10107'))
          return [{ fieldCsszId: '10107', message: 'Krajská pobočka ÚP je povinná, pokud druh oprávnění = Povolení k zaměstnání.' }];
