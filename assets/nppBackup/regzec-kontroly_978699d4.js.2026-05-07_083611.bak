    // ═══ Phase 5: Specifické povinnosti pro jednotlivé akce (PP obligation checks) ═══
    // These controls enforce PP (conditionally mandatory) field obligations from the
    // "Specifické povinnosti" column of the CSV spec. They check whether a field IS FILLED
    // when conditions hold — they do NOT validate field values (that remains in Logické kontroly).

    // R150: client.bno — RČ/EČP mandatory when citizenship = CZ
    // Spec: "Nepovinný u všech A1, je-li občanství ≠ CZ" → mandatory when CZ
    { id: 'R150', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'RČ/EČP: povinné pro občany ČR.',
      check: function(ctx) {
        var act = ctx.getVal('10008');
        if (act !== '1' && act !== '3' && act !== '4') return [];
        var citizenship = ctx.getVal('10067') || '';
        if (citizenship === 'CZ' && !ctx.isFilled('10057'))
          return [{ fieldCsszId: '10057', message: 'Rodné číslo/EČP je povinné pro občany ČR.' }];
        return [];
      }},

    // R151: adr.cnt — Kontrola 1 TRVA gap: stát is not checked in existing R19/R21/R22 Kontrola 1 pattern
    // PP for A3 (all rowTypes), A4 (all rowTypes)
    // Obligation part of deferred R24 (C_STAT codelist)
    { id: 'R151', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Trvalé bydliště – stát: povinný.',
      check: function(ctx) {
        var act = ctx.getVal('10008');
        if (act !== '3' && act !== '4') return [];
        var groupFields = ['10078', '10082', '10080', '10083'];
        var anyFilled = groupFields.some(function (id) { return ctx.isFilled(id); });
        if (anyFilled && !ctx.isFilled('10083'))
          return [{ fieldCsszId: '10083', message: 'Kontrola 1 TRVA: stát je povinný, pokud je vyplněn jiný údaj adresy.' }];
        return [];
      }},

    // R152: cdr.cnt — Kontrola 1 KONTAKT gap: stát not checked in R34/R36/R37
    // PP for A1-OST, A3-OST, A4-OST
    // Obligation part of deferred R38 (C_STAT codelist)
    { id: 'R152', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Kontaktní adresa – stát: povinný.',
      check: function(ctx) {
        var act = ctx.getVal('10008');
        if (act !== '1' && act !== '3' && act !== '4') return [];
        var groupFields = ['10507', '10510', '10509', '10511'];
        var anyFilled = groupFields.some(function (id) { return ctx.isFilled(id); });
        if (anyFilled && !ctx.isFilled('10511'))
          return [{ fieldCsszId: '10511', message: 'Kontrola 1 KONTAKT: stát je povinný, pokud je vyplněn jiný údaj adresy.' }];
        return [];
      }},

    // R153: rdr.* — RDR address mandatory when 10068 ≠ CZ
    // PP for A1-OST/SPEC, A3-OST/SPEC, A4-OST/SPEC
    // For A1: 10068≠CZ → all RDR mandatory
    // For A3/A4: 10068≠CZ → mandatory, OR Kontrola 1 (any group field filled → all mandatory)
    // Existing R41/R43 handle str/onum triggers only. Obligation part of deferred R46.
    // R153: REZIDENCE — 10068 ≠ CZ → mandatory; = CZ → forbidden
    // PP for A1(OST,SPEC), A3(OST,SPEC), A4(OST,SPEC)
    // Z-side: merged from P/N/Z column control (originally R202)
    // CSV column 26 (Z): Kód státu rezidentství (10068) = CZ → REZIDENCE forbidden
    { id: 'R153', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Adresa rezidence: povinnostní podmínka.',
      check: function(ctx) {
        var act = ctx.getVal('10008');
        if (act !== '1' && act !== '3' && act !== '4') return [];
        var rt = getRowType(ctx.emp);
        if (rt !== 'OST' && rt !== 'SPEC') return [];
        var errors = [];
        var mandatory = ['10520', '10522', '10523', '10524'];
        var rezStat = ctx.getVal('10068') || '';
        // P-side: 10068 ≠ CZ → all RDR mandatory
        if (rezStat && rezStat !== 'CZ') {
          mandatory.forEach(function (id) {
            if (!ctx.isFilled(id))
              errors.push({ fieldCsszId: id, message: 'Adresa rezidence je povinná, pokud stát rezidenství ≠ CZ.' });
          });
          return errors;
        }
        // Z-side (from R202): 10068 = CZ → REZIDENCE forbidden
        if (rezStat === 'CZ') {
          mandatory.forEach(function (id) {
            if (ctx.isFilled(id))
              errors.push({ fieldCsszId: id, message: 'Adresa rezidence nesmí být vyplněna, pokud stát rezidenství = CZ.' });
          });
          return errors;
        }
        // For A3/A4: Kontrola 1 RDR — if any group field filled → all mandatory
        if (act === '3' || act === '4') {
          var groupFields = ['10519', '10520', '10521', '10522', '10523', '10524'];
          var anyFilled = groupFields.some(function (id) { return ctx.isFilled(id); });
          if (anyFilled) {
            mandatory.forEach(function (id) {
              if (!ctx.isFilled(id))
                errors.push({ fieldCsszId: id, message: 'Kontrola 1 REZIDENCE: údaj je povinný, pokud je vyplněn jiný údaj adresy rezidence.' });
            });
          }
        }
        return errors;
      }},

    // R156: prof.edu — mandatory when citizenship ≠ CZ
    // PP for A1-OST, A3-OST, A4-OST
    // Obligation part of deferred R76 (CIS Kategorie vzdělání codelist)
    // R156: prof.edu — mandatory when citizenship ≠ CZ; forbidden when = CZ
    // PP for A1-OST, A3-OST, A4-OST
    // Z-side: merged from P/N/Z column control (originally R203)
    // CSV column 26 (Z): Státní občanství (10067) = CZ → 10248 forbidden
    { id: 'R156', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Vzdělání pro profesi: povinnostní podmínka.',
      check: function(ctx) {
        var act = ctx.getVal('10008');
        if (act !== '1' && act !== '3' && act !== '4') return [];
        var rt = getRowType(ctx.emp);
        if (rt !== 'OST') return [];
        var citizenship = ctx.getVal('10067') || '';
        // P-side: ≠CZ → mandatory
        if (citizenship && citizenship !== 'CZ' && !ctx.isFilled('10248'))
          return [{ fieldCsszId: '10248', message: 'Vzdělání pro profesi je povinné, pokud státní občanství ≠ CZ.' }];
        // Z-side (from R203): =CZ → forbidden
        if (citizenship === 'CZ' && ctx.isFilled('10248'))
          return [{ fieldCsszId: '10248', message: 'Vzdělání pro profesi nesmí být vyplněno, pokud státní občanství = CZ.' }];
        return [];
      }},

    // R157: forin.cur — mandatory when activity type = N
    // PP for A1-OST, A3-OST, A4-OST
    // Obligation part of deferred R80 (C_SCIP codelist)
    { id: 'R157', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Specifikace cizozemského nositele: povinná.',
      check: function(ctx) {
        var act = ctx.getVal('10008');
        if (act !== '1' && act !== '3' && act !== '4') return [];
        var rt = getRowType(ctx.emp);
        if (rt !== 'OST') return [];
        var rel = ctx.getVal('10239') || '';
        if (rel === 'N' && !ctx.isFilled('10092'))
          return [{ fieldCsszId: '10092', message: 'Specifikace cizozemského nositele je povinná, pokud druh činnosti = N.' }];
        return [];
      }},

    // R158: forin.cnt — CIZO group obligation (stát)
    // PP for A1-OST, A3-OST, A4-OST
    // If any CIZO field filled → stát mandatory. Special: 10092 only triggers if value = P or S.
    // Obligation part of deferred R87 (C_STAT codelist)
    // R158: forin.cnt — CIZO group obligation (stát)
    // PP for A1-OST, A3-OST, A4-OST
    // If any CIZO field filled → stát mandatory. Special: 10092 only triggers if value = P or S.
    // Z-side: merged from P/N/Z column control (originally R205)
    // CSV column 26 (Z): No CIZO field filled → 10099 forbidden
    { id: 'R158', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Cizozemský nositel – stát: povinnostní podmínka.',
      check: function(ctx) {
        var act = ctx.getVal('10008');
        if (act !== '1' && act !== '3' && act !== '4') return [];
        var rt = getRowType(ctx.emp);
        if (rt !== 'OST') return [];
        var standardFields = ['10093', '10094', '10095', '10096', '10097', '10098', '10100', '10101'];
        var anyStandard = standardFields.some(function (id) { return ctx.isFilled(id); });
        var cur = ctx.getVal('10092') || '';
        var curTriggers = cur === 'P' || cur === 'S';
        var triggered = anyStandard || curTriggers;
        // P-side: triggered → 10099 mandatory
        if (triggered && !ctx.isFilled('10099'))
          return [{ fieldCsszId: '10099', message: 'Stát cizozemského nositele pojištění je povinný, pokud je vyplněn jiný údaj.' }];
        // Z-side (from R205): not triggered → 10099 forbidden
        if (!triggered && ctx.isFilled('10099'))
          return [{ fieldCsszId: '10099', message: 'Stát cizozemského nositele nesmí být vyplněn, pokud není vyplněn žádný jiný údaj sekce.' }];
        return [];
      }},

    // R159: typeempl — Kontrola 3 variant with extended negations
    // PP for A1-OST, A2-OST, A4-OST
    // Same base as Kontrola 3 but negations: 10376∈{2,3}, 10225=A, 10239∈{M,N,O,P,Q,R,S}
    // Z-side: merged from P/N/Z column control (originally R207)
    // CSV column 26 (Z): K3 not obligatory → 10525 forbidden
    { id: 'R159', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Druh zaměstnání: povinnostní podmínka.',
      check: function(ctx) {
        var specialActivities = ['M', 'N', 'O', 'P', 'Q', 'R', 'S'];
        var negs = negBaseExtended(ctx.emp);
        negs.push(function () { return specialActivities.indexOf(getVal(ctx.emp, '10239')) >= 0; });
        var obligatory = isKontrola3Obligatory(ctx.emp, negs);
        // P-side: obligatory → mandatory
        if (obligatory && !ctx.isFilled('10525'))
          return [{ fieldCsszId: '10525', message: 'Druh zaměstnání je povinný.' }];
        // Z-side (from R207): not obligatory → forbidden
        if (!obligatory && ctx.isFilled('10525'))
          return [{ fieldCsszId: '10525', message: 'Druh zaměstnání nesmí být vyplněn, pokud podmínka povinnosti není splněna.' }];
        return [];
      }},

    // R164: rsnterrel — Kontrola 3 + typeempl = 2 (služební poměr)
    // PP for A1-OST, A2-OST, A4-OST
    // Negations: 10376∈{2,3}, 10225=A, 10525≠2
    // Z-side: merged from P/N/Z column control (originally R208)
    // CSV column 26 (Z): K3 not obligatory → 10381 forbidden
    { id: 'R164', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Důvod ukončení služebního poměru: povinnostní podmínka.',
      check: function(ctx) {
        var negs = negBaseExtended(ctx.emp);
        negs.push(function () { return getVal(ctx.emp, '10525') !== '2'; });
        var obligatory = isKontrola3Obligatory(ctx.emp, negs);
        // P-side: obligatory → mandatory
        if (obligatory && !ctx.isFilled('10381'))
          return [{ fieldCsszId: '10381', message: 'Důvod ukončení služebního poměru je povinný (druh zaměstnání = služební poměr).' }];
        // Z-side (from R208): not obligatory → forbidden
        if (!obligatory && ctx.isFilled('10381'))
          return [{ fieldCsszId: '10381', message: 'Důvod ukončení služebního poměru nesmí být vyplněn, pokud podmínka povinnosti není splněna.' }];
        return [];
      }},

    // R165: rsnterempl — Kontrola 3 + typeempl = 1 + activity ∉ {M-S}
    // PP for A1-OST, A2-OST, A4-OST
    // Negations: 10376∈{2,3}, 10225=A, 10239∈{M-S}, 10525≠1
    // Z-side: merged from P/N/Z column control (originally R209)
    // CSV column 26 (Z): K3 not obligatory → 10380 forbidden
    { id: 'R165', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Důvod ukončení pracovněprávního vztahu: povinnostní podmínka.',
      check: function(ctx) {
        var specialActivities = ['M', 'N', 'O', 'P', 'Q', 'R', 'S'];
        var negs = negBaseExtended(ctx.emp);
        negs.push(function () { return specialActivities.indexOf(getVal(ctx.emp, '10239')) >= 0; });
        negs.push(function () { return getVal(ctx.emp, '10525') !== '1'; });
        var obligatory = isKontrola3Obligatory(ctx.emp, negs);
        // P-side: obligatory → mandatory
        if (obligatory && !ctx.isFilled('10380'))
          return [{ fieldCsszId: '10380', message: 'Důvod ukončení pracovněprávního vztahu je povinný.' }];
        // Z-side (from R209): not obligatory → forbidden
        if (!obligatory && ctx.isFilled('10380'))
          return [{ fieldCsszId: '10380', message: 'Důvod ukončení pracovněprávního vztahu nesmí být vyplněn, pokud podmínka povinnosti není splněna.' }];
        return [];
      }},

    // R168: permid — mandatory when citizenship ≠ CZ and freeacc = NE; forbidden otherwise
    // PP for A1-OST/SPEC, A3-OST/SPEC, A4-OST/SPEC
    // Z-side: merged from P/N/Z column control (originally R211)
    // CSV column 26 (Z): Státní občanství = CZ nebo Volný přístup = ANO → 10108 forbidden
    { id: 'R168', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Identifikátor pracovního oprávnění: povinnostní podmínka.',
      check: function(ctx) {
        var act = ctx.getVal('10008');
        if (act !== '1' && act !== '3' && act !== '4') return [];
        var rt = getRowType(ctx.emp);
        if (rt !== 'OST' && rt !== 'SPEC') return [];
        var citizenship = ctx.getVal('10067') || '';
        var freeacc = ctx.getVal('10414') || '';
        // P-side: ≠CZ && =NE → mandatory
        if (citizenship && citizenship !== 'CZ' && isFalseValue(freeacc) && !ctx.isFilled('10108'))
          return [{ fieldCsszId: '10108', message: 'Identifikátor pracovního oprávnění je povinný pro cizince bez volného přístupu.' }];
        // Z-side (from R211): =CZ or =ANO → forbidden
        if ((citizenship === 'CZ' || isTrueValue(freeacc)) && ctx.isFilled('10108'))
          return [{ fieldCsszId: '10108', message: 'Identifikátor pracovního oprávnění nesmí být vyplněn pro občany ČR nebo s volným přístupem.' }];
        return [];
      }},

    // R172: earlyterm — mandatory when job ends before work permit; forbidden otherwise
    // PP for A1-OST/SPEC, A2-OST/SPEC, A4-OST/SPEC
    // A1/A4: filled(10224) && 10106∈{1,2,4} && 10224 < 10110
    // A2: 10106∈{1,2,4} && 10224 < 10110
    // Z-side: merged from P/N/Z column control (originally R212)
    // CSV column 26 (Z): conditions not met → 10534 forbidden
    { id: 'R172', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Důvod předčasného ukončení: povinnostní podmínka.',
      check: function(ctx) {
        var act = ctx.getVal('10008');
        if (act !== '1' && act !== '2' && act !== '4') return [];
        var rt = getRowType(ctx.emp);
        if (rt !== 'OST' && rt !== 'SPEC') return [];
        // A1/A4: job.to must be filled for obligation to trigger
        if ((act === '1' || act === '4') && !ctx.isFilled('10224')) {
          // Z-side: 10224 not filled → 10534 forbidden
          if (ctx.isFilled('10534'))
            return [{ fieldCsszId: '10534', message: 'Důvod předčasného ukončení nesmí být vyplněn, pokud datum skončení zaměstnání není vyplněno.' }];
          return [];
        }
        var permType = ctx.getVal('10106') || '';
        if (permType !== '1' && permType !== '2' && permType !== '4') {
          // Z-side: permType not in {1,2,4} → forbidden
          if (ctx.isFilled('10534'))
            return [{ fieldCsszId: '10534', message: 'Důvod předčasného ukončení nesmí být vyplněn, pokud druh pracovního oprávnění ∉ {1,2,4}.' }];
          return [];
        }
        var jobTo = parseDate(ctx.getVal('10224'));
        var permTo = parseDate(ctx.getVal('10110'));
        if (!jobTo || !permTo) {
          // Z-side: can't compare dates → forbidden
          if (ctx.isFilled('10534'))
            return [{ fieldCsszId: '10534', message: 'Důvod předčasného ukončení nesmí být vyplněn, pokud nelze porovnat data.' }];
          return [];
        }
        // P-side: job ends BEFORE permit → must explain
        if (compareDates(jobTo, permTo) < 0) {
          if (!ctx.isFilled('10534'))
            return [{ fieldCsszId: '10534', message: 'Důvod předčasného ukončení je povinný, pokud zaměstnání končí před koncem pracovního oprávnění.' }];
        } else {
          // Z-side: job ends ON or AFTER permit → forbidden
          if (ctx.isFilled('10534'))
            return [{ fieldCsszId: '10534', message: 'Důvod předčasného ukončení nesmí být vyplněn, pokud zaměstnání nekončí před koncem pracovního oprávnění.' }];
        }
        return [];
      }},

    // ═══ Phase 6: P/N/Z column controls (CSV columns 24-26) ═══
    // These controls enforce the P (mandatory), N (optional override), Z (forbidden)
    // conditions from the P/N/Z columns of the CSV spec.
    // 13 controls were merged into existing Phase 5 / Logické kontroly (see MERGED section below).
    // Remaining 12 controls (R200-R211) are standalone with complete P+Z logic.

    // R200: POBYT obligation — trva.cnt ≠ CZ → POBYT fields mandatory; = CZ → forbidden
    // P: A1,A3,A4: Trvalý pobyt - stát (10083) <> CZ
    // N: A1: Trvalý pobyt - stát (10083) = DE, PL, SK, AT (cross-border exception)
    // Z: A1,A3,A4: Trvalý pobyt - stát (10083) = CZ → forbidden
    // PP actions: A1(OST,SPEC), A3(OST,SPEC), A4(OST,SPEC)
    { id: 'R200', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Pobyt v ČR: povinnostní podmínka.',
      check: function(ctx) {
        var act = ctx.getVal('10008');
        if (act !== '1' && act !== '3' && act !== '4') return [];
        var rt = getRowType(ctx.emp);
        if (rt !== 'OST' && rt !== 'SPEC') return [];
        var trvaStát = ctx.getVal('10083') || '';
        var fields = ['10514', '10517', '10516'];
        var errors = [];
        // Z-side: trva.cnt = CZ → POBYT fields forbidden
        if (trvaStát === 'CZ') {
          fields.forEach(function (id) {
            if (ctx.isFilled(id))
              errors.push({ fieldCsszId: id, message: 'Údaj pobytu v ČR nesmí být vyplněn, pokud trvalý pobyt stát = CZ.' });
          });
          return errors;
        }
        // P-side: trva.cnt ≠ CZ → POBYT fields mandatory
        if (trvaStát && trvaStát !== 'CZ') {
          // N exception for A1: cross-border countries → optional
          if (act === '1' && ['DE','PL','SK','AT'].indexOf(trvaStát) >= 0) return [];
          // A3/A4: group-fill rule — fdr only mandatory when at least one fdr field is already present
          if ((act === '3' || act === '4') && !fields.some(function(id) { return ctx.isFilled(id); })) return [];
          fields.forEach(function (id) {
            if (!ctx.isFilled(id))
              errors.push({ fieldCsszId: id, message: 'Údaj pobytu v ČR je povinný, pokud trvalý pobyt stát ≠ CZ.' });
          });
        }
        return errors;
      }},

    // R201: forinreg.state — 10427 = A → 10428 mandatory; 10427 ≠ A → 10428 forbidden
    // P: Příslušnost k cizím právním předpisům (10427) = A
    // Z: Příslušnost k cizím právním předpisům (10427) ≠ A (including N or empty)
    // PP actions: A1-OST, A3-OST, A4-OST
    { id: 'R201', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Příslušnost k cizím právním předpisům – stát: povinnostní podmínka.',
      check: function(ctx) {
        var act = ctx.getVal('10008');
        if (act !== '1' && act !== '3' && act !== '4') return [];
        var rt = getRowType(ctx.emp);
        if (rt !== 'OST') return [];
        var jurisIsTrue = isTrueValue(ctx.getVal('10427'));
        if (jurisIsTrue && !ctx.isFilled('10428'))
          return [{ fieldCsszId: '10428', message: 'Stát cizích právních předpisů je povinný, pokud je příslušnost = A.' }];
        if (!jurisIsTrue && ctx.isFilled('10428'))
          return [{ fieldCsszId: '10428', message: 'Stát cizích právních předpisů nesmí být vyplněn, pokud příslušnost není A.' }];
        return [];
      }},

    // R202: proofid — mandatory when citizenship ≠ CZ; forbidden when = CZ
    // P: Státní občanství (10067) <> CZ
    // Z: Státní občanství (10067) = CZ
    // PP actions: A1(OST,SPEC), A3(OST,SPEC), A4(OST,SPEC)
    { id: 'R202', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Doklad totožnosti: povinnostní podmínka.',
      check: function(ctx) {
        var act = ctx.getVal('10008');
        if (act !== '1' && act !== '3' && act !== '4') return [];
        var rt = getRowType(ctx.emp);
        if (rt !== 'OST' && rt !== 'SPEC') return [];
        var citizenship = ctx.getVal('10067') || '';
        var fields = ['10069', '10070', '10071', '10072'];
        var errors = [];
        // P-side: ≠CZ → mandatory
        if (citizenship && citizenship !== 'CZ') {
          fields.forEach(function (id) {
            if (!ctx.isFilled(id))
              errors.push({ fieldCsszId: id, message: 'Údaj dokladu totožnosti je povinný, pokud státní občanství ≠ CZ.' });
          });
        }
        // Z-side: =CZ → forbidden
        if (citizenship === 'CZ') {
          fields.forEach(function (id) {
            if (ctx.isFilled(id))
              errors.push({ fieldCsszId: id, message: 'Údaj dokladu totožnosti nesmí být vyplněn, pokud státní občanství = CZ.' });
          });
        }
        return errors;
      }},

    // R203: nocitizen.freeacc — mandatory when citizenship ≠ CZ; forbidden when = CZ
    // P: Státní občanství (10067) <> CZ
    // Z: Státní občanství (10067) = CZ
    // PP actions: A1(OST,SPEC), A3(OST,SPEC), A4(OST,SPEC)
    { id: 'R203', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Volný přístup na trh práce: povinnostní podmínka.',
      check: function(ctx) {
        var act = ctx.getVal('10008');
        if (act !== '1' && act !== '3' && act !== '4') return [];
        var rt = getRowType(ctx.emp);
        if (rt !== 'OST' && rt !== 'SPEC') return [];
        var citizenship = ctx.getVal('10067') || '';
        if (citizenship && citizenship !== 'CZ' && !ctx.isFilled('10414'))
          return [{ fieldCsszId: '10414', message: 'Volný přístup na trh práce je povinný, pokud státní občanství ≠ CZ.' }];
        if (citizenship === 'CZ' && ctx.isFilled('10414'))
          return [{ fieldCsszId: '10414', message: 'Volný přístup na trh práce nesmí být vyplněn, pokud státní občanství = CZ.' }];
        return [];
      }},

    // R204: nocitizen.permtype — mandatory when ≠CZ && freeacc=NE; forbidden when CZ or freeacc=ANO
    // P: Státní občanství (10067) <> CZ && Volný přístup (10414) = NE
    // Z: Státní občanství (10067) = CZ nebo Volný přístup (10414) = ANO
    // PP actions: A1(OST,SPEC), A3(OST,SPEC), A4(OST,SPEC)
    { id: 'R204', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Druh pracovního oprávnění: povinnostní podmínka.',
      check: function(ctx) {
        var act = ctx.getVal('10008');
        if (act !== '1' && act !== '3' && act !== '4') return [];
        var rt = getRowType(ctx.emp);
        if (rt !== 'OST' && rt !== 'SPEC') return [];
        var citizenship = ctx.getVal('10067') || '';
        var freeacc = ctx.getVal('10414') || '';
        // P-side: ≠CZ && =NE → mandatory
        if (citizenship && citizenship !== 'CZ' && isFalseValue(freeacc) && !ctx.isFilled('10106'))
          return [{ fieldCsszId: '10106', message: 'Druh pracovního oprávnění je povinný, pokud občanství ≠ CZ a volný přístup = NE.' }];
        // Z-side: =CZ or =ANO → forbidden
        if ((citizenship === 'CZ' || isTrueValue(freeacc)) && ctx.isFilled('10106'))
          return [{ fieldCsszId: '10106', message: 'Druh pracovního oprávnění nesmí být vyplněn, pokud občanství = CZ nebo volný přístup = ANO.' }];
        return [];
      }},

    // R205: nocitizen.perm — mandatory when ≠CZ && freeacc=ANO; forbidden when CZ or freeacc=NE
    // P: Státní občanství (10067) <> CZ && Volný přístup (10414) = ANO
    // Z: Státní občanství (10067) = CZ nebo Volný přístup (10414) = NE
    // PP actions: A1(OST,SPEC), A3(OST,SPEC), A4(OST,SPEC)
    { id: 'R205', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Důvod volného přístupu: povinnostní podmínka.',
      check: function(ctx) {
        var act = ctx.getVal('10008');
        if (act !== '1' && act !== '3' && act !== '4') return [];
