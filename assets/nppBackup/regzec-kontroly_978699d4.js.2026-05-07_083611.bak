      }},

    // R116: nocitizen.freeacc — A/N; if 10067 ≠ CZ → mandatory
    { id: 'R116', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Volný přístup na trh práce: neplatné.',
      check: function(ctx) {
        var cnt = ctx.getVal('10067') || '';
        if (cnt && cnt !== 'CZ') {
          if (!ctx.isFilled('10414'))
            return [{ fieldCsszId: '10414', message: 'Volný přístup na trh práce je povinný pro cizince.' }];
        }
        var v = ctx.getVal('10414');
        if (v) return checkBoolean(ctx, '10414');
        return [];
      }},

    // R117: nocitizen.permtype — if 10067≠CZ AND 10414=NE → mandatory (codelist value deferred)
    { id: 'R117', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Druh pracovního oprávnění: povinný.',
      check: function(ctx) {
        var cnt = ctx.getVal('10067') || '';
        var freeacc = ctx.getVal('10414') || '';
        if (cnt && cnt !== 'CZ' && isFalseValue(freeacc) && !ctx.isFilled('10106'))
          return [{ fieldCsszId: '10106', message: 'Druh pracovního oprávnění je povinný, pokud občanství ≠ CZ a volný přístup = NE.' }];
        return [];
      }},

    // R118: nocitizen.perm — if 10067≠CZ AND 10414=ANO → mandatory (codelist value deferred)
    { id: 'R118', scope: 'emp', sev: 'error', type: 'custom',
