      }},

    // R111: fact.ztp — A/N; if 10085 filled → mandatory
    { id: 'R111', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Držitel ZTP/P: neplatné.',
      check: function(ctx) {
        if (ctx.isFilled('10085') && !ctx.isFilled('10090'))
          return [{ fieldCsszId: '10090', message: 'Držitel ZTP/P je povinný, pokud je uveden typ zdravotního omezení.' }];
        var v = ctx.getVal('10090');
        if (v) return checkBoolean(ctx, '10090');
        return [];
      }},

    // R133: job.preplace — if 10067 ≠ CZ → mandatory
    // R133: job.preplace — mandatory when citizenship ≠ CZ; forbidden when = CZ
    // Z-side: merged from P/N/Z column control (originally R221)
    // CSV column 26 (Z): Státní občanství (10067) = CZ → 10526 forbidden
    { id: 'R133', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Předpokládané místo výkonu: povinnostní podmínka.',
      check: function(ctx) {
        var cnt = ctx.getVal('10067') || '';
        // P-side: ≠CZ → mandatory
        if (cnt && cnt !== 'CZ' && !ctx.isFilled('10526'))
          return [{ fieldCsszId: '10526', message: 'Předpokládané místo výkonu práce je povinné, pokud občanství ≠ CZ.' }];
        // Z-side (from R221): =CZ → forbidden (A1/A3/A4, OST/SPEC)
        if (cnt === 'CZ' && ctx.isFilled('10526')) {
          var act = ctx.getVal('10008');
          var rt = getRowType(ctx.emp);
          if ((act === '1' || act === '3' || act === '4') && (rt === 'OST' || rt === 'SPEC'))
            return [{ fieldCsszId: '10526', message: 'Předpokládané místo výkonu práce nesmí být vyplněno, pokud občanství = CZ.' }];
        }
        return [];
      }},

    // ═══ Phase 4b: Kontrola 3 — unemployment section conditionals ═══

    // R98: pensionperiod.fro — Kontrola 3 (negation: 10376=2 OR 10225=A)
    { id: 'R98', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Pojištění od: povinné (Kontrola 3).',
      check: function(ctx) {
        if (!isKontrola3Obligatory(ctx.emp, negBase(ctx.emp))) return [];
        var n = ctx.getRepeatCount('unemplcomp/pensionperiod');
        if (n === 0)
          return [{ fieldCsszId: '10386', message: 'Interval důchodového pojištění (od) je povinný.' }];
        var errors = [];
        for (var i = 0; i < n; i++) {
          if (!ctx.isFilled('10386', i))
            errors.push({ fieldCsszId: '10386', instanceIndex: i, message: 'Pojištění od je povinné.' });
        }
        return errors;
      }},

    // R100: unemplcomp.belong — A/N; Kontrola 3 (negation: 10376=2|3 OR 10225=A OR 10380 ≠ 4,5)
    { id: 'R100', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Nárok na odstupné: neplatné.',
      check: function(ctx) {
        var v = ctx.getVal('10378');
        if (v) {
          var be = checkBoolean(ctx, '10378');
          if (be.length > 0) return be;
        }
        var negs = negBaseExtended(ctx.emp);
        negs.push(function () {
          var rsnterempl = getVal(ctx.emp, '10380') || '';
          return rsnterempl !== '' && rsnterempl !== '4' && rsnterempl !== '5';
        });
        if (!isKontrola3Obligatory(ctx.emp, negs)) return [];
        if (!ctx.isFilled('10378'))
          return [{ fieldCsszId: '10378', message: 'Nárok na odstupné je povinný (Kontrola 3).' }];
        return [];
      }},

    // R105: unemplcomp.fullpay — A/N; if 10378=A → mandatory; if 10378=N → must not be filled
    { id: 'R105', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Vyplaceno v plné výši: neplatné.',
      check: function(ctx) {
        var belong = ctx.getVal('10378') || '';
        if (isTrueValue(belong)) {
          if (!ctx.isFilled('10379'))
            return [{ fieldCsszId: '10379', message: 'Vyplaceno v plné výši je povinné, pokud nárok na odstupné = A.' }];
          return checkBoolean(ctx, '10379');
        }
        if (isFalseValue(belong) && ctx.isFilled('10379'))
          return [{ fieldCsszId: '10379', message: 'Vyplaceno v plné výši nesmí být vyplněno, pokud nárok na odstupné = N.' }];
        return [];
      }},

    // R106: unemplcomp.avgmonear — Kontrola 3 (negation: 10376=2 OR 10225=A)
    { id: 'R106', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Průměrný čistý výdělek: povinný (Kontrola 3).',
      check: function(ctx) {
        if (!isKontrola3Obligatory(ctx.emp, negBase(ctx.emp))) return [];
        if (!ctx.isFilled('10377'))
          return [{ fieldCsszId: '10377', message: 'Průměrný čistý výdělek je povinný (Kontrola 3).' }];
        return [];
      }},

    // R137: unemplcomp.replacement — typeempl=1 only; Kontrola 3; mutual group with 10531
    { id: 'R137', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Jednorázová náhrada: neplatné.',
      check: function(ctx) {
        // Can only be filled if typeempl = 1
        var typeempl = ctx.getVal('10525') || '';
        if (ctx.isFilled('10530') && typeempl !== '1')
          return [{ fieldCsszId: '10530', message: 'Jednorázová náhrada může být vyplněna pouze pokud druh zaměstnání = 1.' }];
        // Mutual group: if belong=A && typeempl=1 && 10531 not filled → 10530 mandatory
        var belong = ctx.getVal('10378') || '';
        if (isTrueValue(belong) && typeempl === '1' && !ctx.isFilled('10531') && !ctx.isFilled('10530'))
          return [{ fieldCsszId: '10530', message: 'Musí být vyplněn jeden z údajů: Jednorázová náhrada nebo Odstupné §67.' }];
        return [];
      }},

    // R138: unemplcomp.goldenhandshake — typeempl=1 only; mutual group with 10530
    { id: 'R138', scope: 'emp', sev: 'error', type: 'custom',
