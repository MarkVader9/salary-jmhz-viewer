        if (rt !== 'OST' && rt !== 'SPEC') return [];
        // P-side: 10068 filled → 10459 mandatory
        if (ctx.isFilled('10068') && !ctx.isFilled('10459'))
          return [{ fieldCsszId: '10459', message: 'Platnost změny od je povinná, pokud je vyplněn kód státu rezidentství.' }];
        // Z-side: 10068 not filled → 10459 forbidden
        if (!ctx.isFilled('10068') && ctx.isFilled('10459'))
          return [{ fieldCsszId: '10459', message: 'Platnost změny od nesmí být vyplněna bez vyplnění kódu státu rezidentství.' }];
        return [];
      }},

    // R210: replacement/goldenhandshake — mutual group obligation
    // P: 10378=A && typeempl(10525)=1 && other not filled → at least one mandatory
    // Z: 10378=N → both forbidden; typeempl≠1 → both forbidden; both filled → mutual exclusion error
    // PP actions: A1-OST, A2-OST, A4-OST
    { id: 'R210', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Jednorázová náhrada / Odstupné §67: povinnostní podmínka.',
      check: function(ctx) {
        var act = ctx.getVal('10008');
        if (act !== '1' && act !== '2' && act !== '4') return [];
        var rt = getRowType(ctx.emp);
        if (rt !== 'OST') return [];
        var belong = ctx.getVal('10378') || '';
        var typeempl = ctx.getVal('10525') || '';
        var f530 = ctx.isFilled('10530');
        var f531 = ctx.isFilled('10531');
        var errors = [];
        // Z-side: 10378=N → both forbidden
        if (isFalseValue(belong)) {
          if (f530) errors.push({ fieldCsszId: '10530', message: 'Jednorázová náhrada nesmí být vyplněna, pokud nárok na odstupné = N.' });
          if (f531) errors.push({ fieldCsszId: '10531', message: 'Odstupné §67 nesmí být vyplněno, pokud nárok na odstupné = N.' });
          return errors;
        }
        // Z-side: typeempl≠1 → both forbidden
        if (typeempl !== '1') {
          if (f530) errors.push({ fieldCsszId: '10530', message: 'Jednorázová náhrada nesmí být vyplněna, pokud druh zaměstnání ≠ 1.' });
          if (f531) errors.push({ fieldCsszId: '10531', message: 'Odstupné §67 nesmí být vyplněno, pokud druh zaměstnání ≠ 1.' });
          return errors;
        }
        // Z-side: both filled → mutual exclusion
        if (f530 && f531) {
          errors.push({ fieldCsszId: '10530', message: 'Jednorázová náhrada a Odstupné §67 nemohou být vyplněny současně.' });
          return errors;
        }
        // P-side: 10378=A && typeempl=1 → at least one mandatory
        if (isTrueValue(belong) && !f530 && !f531) {
          errors.push({ fieldCsszId: '10530', message: 'Musí být vyplněn jeden z údajů: Jednorázová náhrada nebo Odstupné §67.' });
        }
        return errors;
      }},

    // R211: severancepay/disposal — mutual group obligation
    // P: 10378=A && typeempl(10525)=2 && other not filled → at least one mandatory
    // Z: 10378=N → both forbidden; typeempl≠2 → both forbidden; both filled → mutual exclusion error
    // PP actions: A1-OST, A2-OST, A4-OST
    { id: 'R211', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Odchodné / Odbytné: povinnostní podmínka.',
      check: function(ctx) {
        var act = ctx.getVal('10008');
        if (act !== '1' && act !== '2' && act !== '4') return [];
        var rt = getRowType(ctx.emp);
        if (rt !== 'OST') return [];
        var belong = ctx.getVal('10378') || '';
        var typeempl = ctx.getVal('10525') || '';
        var f532 = ctx.isFilled('10532');
        var f533 = ctx.isFilled('10533');
        var errors = [];
        // Z-side: 10378=N → both forbidden
        if (isFalseValue(belong)) {
          if (f532) errors.push({ fieldCsszId: '10532', message: 'Odchodné nesmí být vyplněno, pokud nárok na odstupné = N.' });
          if (f533) errors.push({ fieldCsszId: '10533', message: 'Odbytné nesmí být vyplněno, pokud nárok na odstupné = N.' });
          return errors;
        }
        // Z-side: typeempl≠2 → both forbidden
        if (typeempl !== '2') {
          if (f532) errors.push({ fieldCsszId: '10532', message: 'Odchodné nesmí být vyplněno, pokud druh zaměstnání ≠ 2.' });
          if (f533) errors.push({ fieldCsszId: '10533', message: 'Odbytné nesmí být vyplněno, pokud druh zaměstnání ≠ 2.' });
          return errors;
        }
        // Z-side: both filled → mutual exclusion
        if (f532 && f533) {
          errors.push({ fieldCsszId: '10532', message: 'Odchodné a Odbytné nemohou být vyplněny současně.' });
          return errors;
        }
        // P-side: 10378=A && typeempl=2 → at least one mandatory
        if (isTrueValue(belong) && !f532 && !f533) {
          errors.push({ fieldCsszId: '10532', message: 'Musí být vyplněn jeden z údajů: Odchodné nebo Odbytné.' });
        }
        return errors;
      }}

