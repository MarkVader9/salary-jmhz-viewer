        if (rt !== 'OST' && rt !== 'SPEC') return [];
        var citizenship = ctx.getVal('10067') || '';
        var freeacc = ctx.getVal('10414') || '';
        // P-side: ≠CZ && =ANO → mandatory
        if (citizenship && citizenship !== 'CZ' && isTrueValue(freeacc) && !ctx.isFilled('10105'))
          return [{ fieldCsszId: '10105', message: 'Důvod volného přístupu je povinný, pokud občanství ≠ CZ a volný přístup = ANO.' }];
        // Z-side: =CZ or =NE → forbidden
        if ((citizenship === 'CZ' || isFalseValue(freeacc)) && ctx.isFilled('10105'))
          return [{ fieldCsszId: '10105', message: 'Důvod volného přístupu nesmí být vyplněn, pokud občanství = CZ nebo volný přístup = NE.' }];
        return [];
      }},

    // R206: nocitizen.issue — mandatory when 10106=1; forbidden when 10106≠1
    // P: Druh pracovního oprávnění (10106) = Povolení k zaměstnání (=1)
    // Z: Druh pracovního oprávnění (10106) <> 1 nebo nevyplněno
    // PP actions: A1(OST,SPEC), A3(OST,SPEC), A4(OST,SPEC)
    { id: 'R206', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Krajská pobočka ÚP: povinnostní podmínka.',
      check: function(ctx) {
        var act = ctx.getVal('10008');
        if (act !== '1' && act !== '3' && act !== '4') return [];
        var rt = getRowType(ctx.emp);
        if (rt !== 'OST' && rt !== 'SPEC') return [];
        var permType = ctx.getVal('10106') || '';
        // P-side: 10106=1 → mandatory
        if (permType === '1' && !ctx.isFilled('10107'))
          return [{ fieldCsszId: '10107', message: 'Krajská pobočka ÚP je povinná, pokud druh oprávnění = Povolení k zaměstnání.' }];
        // Z-side: 10106≠1 → forbidden
        if (permType !== '1' && ctx.isFilled('10107'))
          return [{ fieldCsszId: '10107', message: 'Krajská pobočka ÚP nesmí být vyplněna, pokud druh oprávnění ≠ Povolení k zaměstnání.' }];
