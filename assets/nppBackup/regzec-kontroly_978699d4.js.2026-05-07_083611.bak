        if (act === '1' || act === '3' || act === '4') {
          var trvaStát = ctx.getVal('10083') || '';
          // Cross-border exception for A1
          if (act === '1' && trvaStát !== 'CZ' && ['DE','PL','SK','AT'].indexOf(trvaStát) >= 0) return errors;
          var groupFields = ['10514', '10517', '10516'];
          var anyFilled = groupFields.some(function (id) { return ctx.isFilled(id); });
          if (act === '1' && anyFilled && !ctx.isFilled('10514'))
            errors.push({ fieldCsszId: '10514', message: 'Kontrola 1 POBYT: číslo popisné je povinné.' });
          if ((act === '3' || act === '4') && anyFilled && !ctx.isFilled('10514'))
            errors.push({ fieldCsszId: '10514', message: 'Kontrola 1 POBYT: číslo popisné je povinné, pokud je vyplněn jiný údaj adresy.' });
        }
