      msg: 'Trvalé bydliště – číslo orientační: neplatné.',
      check: function(ctx) {
        var onum = ctx.getVal('10079');
        if (!onum) return [];
        var errors = [];
        var cnt = ctx.getVal('10083') || '';
        if (cnt === 'CZ') {
          if (onum.length > 4) errors.push({ fieldCsszId: '10079', message: 'Číslo orientační (trvalé bydliště): pro CZ max. 4 znaky.' });
        } else {
          if (onum.length > 12) errors.push({ fieldCsszId: '10079', message: 'Číslo orientační (trvalé bydliště): max. 12 znaků.' });
        }
        // If onum filled → other address fields must be filled
        var mandatory = ['10078', '10082', '10080', '10083'];
        var missing = mandatory.filter(function (id) { return !ctx.isFilled(id); });
        if (missing.length > 0)
          errors.push({ fieldCsszId: missing[0], message: 'Je-li vyplněno č.o. trvalého bydliště, musí být vyplněny i ostatní údaje adresy.' });
        return errors;
      }},

