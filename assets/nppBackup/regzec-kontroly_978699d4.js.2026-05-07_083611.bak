// === REG-ZEC Business Rule Controls (Kontroly) ===
// Based on ČSSZ regzec-datova-veta.csv — Registr zaměstnavatelů a zaměstnanců
// 93 implemented R-controls + 1 consolidated deprecated-fields check (RDEP)
// Skipped controls documented at end of file (codelist, removed, merged, overlap)

(function () {
  'use strict';

  var KU = window.KontrolyUtils;
  var buildCsszIndex = KU.buildCsszIndex;
  var fieldKeyFor = KU.fieldKeyFor;
  var getVal = KU.getVal;
  var getNum = KU.getNum;
  var isFilled = KU.isFilled;
  var getFieldDef = KU.getFieldDef;
  var getFieldLabel = KU.getFieldLabel;
  var getSectionLabel = KU.getSectionLabel;
  var getRepeatCount = KU.getRepeatCount;
  var isTrueValue = KU.isTrueValue;
  var isFalseValue = KU.isFalseValue;
  var findChildEl = KU.findChildEl;
  var evalRule = KU.evalRule;
  var validateRCModulo11 = KU.validateRCModulo11;
  var validateIKMPSV = KU.validateIKMPSV;
  var luhnCheck = KU.luhnCheck;
  var validateCzPsc = KU.validateCzPsc;
  var parseDate = KU.parseDate;
  var compareDates = KU.compareDates;
  var addDays = KU.addDays;
  var formatDate = KU.formatDate;
  var todayDate = KU.todayDate;
  var ageAt = KU.ageAt;

  // ── REG-ZEC Specific Helpers ──────────────────────────────────

  var _sqnrCounts = null; // R0 frequency cache, reset per run
  var _fieldRules = null; // csszId → { actionCode → 'P'|'PP'|'N'|'P-OST'|'N-OST'|'/' }, set per run by runKontroly

  // Iterate the per-action fieldRules table for an employee's current action,
  // invoking visit(csszId, requirement, fieldDef, instanceIndex) for every
  // applicable (field, instance) pair. Skips fields with no def or no rule
  // for the given action. Repeating sections expand to one call per instance.
  function forEachActionField(emp, visit) {
    if (!_fieldRules) return;
    var act = getVal(emp, '10008') || '';
    if (!act) return;
    Object.keys(_fieldRules).forEach(function (csszId) {
      var req = _fieldRules[csszId] && _fieldRules[csszId][act];
      if (!req) return;
      var fd = getFieldDef(csszId);
      if (!fd) return;
      var n = getRepeatCount(emp, fd.section);
      if (n > 0) {
        for (var i = 0; i < n; i++) visit(csszId, req, fd, i);
      } else {
        visit(csszId, req, fd, undefined);
      }
    });
  }

  // Determine row type from job.rel + job.relDetail (mirrors REGZEC_CONFIG.determineRowType)
  function getRowType(emp) {
    var rel = getVal(emp, '10239') || '';
    var relDetail = getVal(emp, '10502') || '';
    if (!rel) return 'OST';
    if (['11','12','13','14','M'].indexOf(rel) >= 0) return 'SPEC';
    if (rel === '10') return '10';
    if (/^[1-9]$/.test(rel) && relDetail === '2') return 'SPEC';
    return 'OST';
  }

  // Kontrola 3 obligation check (unemployment section).
  // Returns true if the field IS obligatory given action + negation conditions.
  // negations: array of negation check functions, each returns true to cancel obligation.
  function isKontrola3Obligatory(emp, negations) {
    var act = getVal(emp, '10008') || '';
    var rowType = getRowType(emp);
    if (rowType !== 'OST') return false;
    var obligatory = false;
    if (act === '1' && isFilled(emp, '10224')) obligatory = true;
    if (act === '2') obligatory = true;
    if (act === '4' && isFilled(emp, '10224')) obligatory = true;
    if (!obligatory) return false;
    // Check negation conditions — any true negation cancels obligation
    for (var i = 0; i < negations.length; i++) {
      if (negations[i]()) return false;
    }
    return true;
  }

  // Standard negation: 10376=2 OR 10225=A
  function negBase(emp) {
    return [
      function () { return getVal(emp, '10376') === '2'; },
      function () { return isTrueValue(getVal(emp, '10225')); }
    ];
  }

  // Extended negation: 10376=2 OR 10376=3 OR 10225=A
  function negBaseExtended(emp) {
    return [
      function () { var v = getVal(emp, '10376'); return v === '2' || v === '3'; },
      function () { return isTrueValue(getVal(emp, '10225')); }
    ];
  }

  // Address completeness: if any field in the group is filled, then listed mandatory fields must be filled.
  // groupFields: all fields in the address group (for "any filled" check)
  // mandatoryFields: fields that become mandatory when group is active
  // Returns array of error objects.
  function checkAddressGroup(emp, groupFields, mandatoryFields, controlPrefix) {
    var errors = [];
    var anyFilled = groupFields.some(function (id) { return isFilled(emp, id); });
    if (!anyFilled) return errors;
    mandatoryFields.forEach(function (mf) {
      if (!isFilled(emp, mf.csszId)) {
        errors.push({ fieldCsszId: mf.csszId, message: mf.msg || (controlPrefix + ': ' + getFieldLabel(mf.csszId) + ' je povinný, pokud je vyplněn jiný údaj adresy.') });
      }
    });
    return errors;
  }

  // Validate A/N boolean field. Returns error array.
  function checkBoolean(ctx, csszId) {
    var v = ctx.getVal(csszId);
    if (!v) return [];
    if (!isTrueValue(v) && !isFalseValue(v))
      return [{ fieldCsszId: csszId, message: getFieldLabel(csszId) + ': Hodnota musí být „A" nebo „N".' }];
    return [];
  }

  // ── Control Definitions ─────────────────────────────────────
  // All controls run at scope: 'emp' (per-employee).
  // sev: 'error' = nepropustná, 'warning' = propustná

  var KONTROLY = [

    // ═══ Phase 0: Per-action requirement scan (R300 / R301) ═══
    // Driven by formats.js → fieldRules. R300 flags missing required ('P',
    // and 'P-OST' on OST rows) fields for the employee's action. R301 flags
    // forbidden ('/') fields that are filled. Both run only when the
    // employee has action 10008 set and a fieldRules table is supplied via
    // the runKontroly API.

    { id: 'R300', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Povinné pole pro zvolenou akci není vyplněno.',
      check: function(ctx) {
        var errors = [];
        var act = ctx.getVal('10008');
        if (!act) return errors;
        var rowType = getRowType(ctx.emp);
        forEachActionField(ctx.emp, function (csszId, req, fd, ii) {
          var required = req === 'P' || (req === 'P-OST' && rowType === 'OST');
          if (!required) return;
          if (ctx.isFilled(csszId, ii)) return;
          errors.push({
            fieldCsszId: csszId,
            instanceIndex: ii,
            message: 'Povinné pole pro akci A' + act + ' není vyplněno: ' + getFieldLabel(csszId) + '.'
          });
        });
        return errors;
      }},

    { id: 'R301', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Pole je pro zvolenou akci zakázáno, ale je vyplněno.',
      check: function(ctx) {
        var errors = [];
        var act = ctx.getVal('10008');
        if (!act) return errors;
        forEachActionField(ctx.emp, function (csszId, req, fd, ii) {
          if (req !== '/') return;
          if (!ctx.isFilled(csszId, ii)) return;
          errors.push({
            fieldCsszId: csszId,
            instanceIndex: ii,
            message: 'Pole je pro akci A' + act + ' zakázáno, ale je vyplněno: ' + getFieldLabel(csszId) + '.'
          });
        });
        return errors;
      }},

    // ═══ Phase 1: Format & syntax validations ═══

    // R0: employee.sqnr uniqueness (uses pre-built frequency map)
    { id: 'R0', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Duplicitní pořadové číslo věty.',
      check: function(ctx) {
        var sqnr = ctx.emp.fields['employee/sqnr']?.value || '';
        if (!sqnr) return [];
        if (!_sqnrCounts) {
          _sqnrCounts = {};
          ctx.allEmps.forEach(function (e) {
            var s = e.fields['employee/sqnr']?.value || '';
            if (s) _sqnrCounts[s] = (_sqnrCounts[s] || 0) + 1;
          });
        }
        if (_sqnrCounts[sqnr] > 1) return [{ message: ctx.rule.msg }];
        return [];
      }},

    // R3: employee.dat — date format YYYY-MM-DD + not future
    { id: 'R3', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Datum vyplnění: neplatný formát nebo je v budoucnu.',
      check: function(ctx) {
        var v = ctx.getVal('10005');
        if (!v) return [];
        if (!/^\d{4}-\d{2}-\d{2}$/.test(v)) return [{ fieldCsszId: '10005', message: 'Datum vyplnění: neplatný formát (očekáváno RRRR-MM-DD).' }];
        var today = formatDate(todayDate());
        if (v > today) return [{ fieldCsszId: '10005', message: 'Datum vyplnění nesmí být v budoucnu.' }];
        return [];
      }},

    // R4: employee.fro — for A3/A5/A6/A7: job.fro <= employee.fro; always: employee.fro <= today
    { id: 'R4', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Datum platnosti od: neplatné.',
      check: function(ctx) {
        var fro = ctx.getVal('10009');
        if (!fro) return [];
        var errors = [];
        var act = ctx.getVal('10008');
        if (act === '3' || act === '5' || act === '6' || act === '7') {
          var jobFro = ctx.getVal('10223');
          if (jobFro && jobFro > fro)
            errors.push({ fieldCsszId: '10009', message: 'Datum nástupu do zaměstnání (10223) musí být ≤ datum platnosti od (10009).' });
        }
        var today = formatDate(todayDate());
        if (fro > today)
          errors.push({ fieldCsszId: '10009', message: 'Datum platnosti od nesmí být v budoucnu.' });
        return errors;
      }},

    // R5: client.bno — RČ/EČP syntax + modulo 11 + birth date cross-check
    { id: 'R5', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Rodné číslo / EČP: chybný formát.',
      check: function(ctx) {
        var bno = ctx.getVal('10057');
        if (!bno) return [];
        var result = validateRCModulo11(bno);
        if (!result.valid) {
          if (result.error === 'format') return [{ fieldCsszId: '10057', message: 'RČ/EČP: neplatný formát (očekáváno 9–10 číslic).' }];
          if (result.error === 'modulo') return [{ fieldCsszId: '10057', message: 'RČ/EČP: neprošlo kontrolou modulo 11.' }];
        }
        // Birth date cross-check
        var digits = result.digits;
        if (digits && digits.length >= 6) {
          var birthDat = ctx.getVal('10056');
          if (birthDat && /^\d{4}-\d{2}-\d{2}$/.test(birthDat)) {
            var rcYear = parseInt(digits.substring(0, 2), 10);
            var rcMonth = parseInt(digits.substring(2, 4), 10);
            var rcDay = parseInt(digits.substring(4, 6), 10);
            // Adjust month (women +50, sometimes +70 for extra capacity)
            if (rcMonth > 70) rcMonth -= 70;
            else if (rcMonth > 50) rcMonth -= 50;
            else if (rcMonth > 20) rcMonth -= 20;
            // Determine century
            var fullYear = rcYear + (digits.length === 10 ? (rcYear < 54 ? 2000 : 1900) : 1900);
            var bdParts = birthDat.split('-');
            var bdYear = parseInt(bdParts[0], 10);
            var bdMonth = parseInt(bdParts[1], 10);
            var bdDay = parseInt(bdParts[2], 10);
            if (fullYear !== bdYear || rcMonth !== bdMonth || rcDay !== bdDay)
              return [{ fieldCsszId: '10057', message: 'RČ/EČP neodpovídá datu narození.' }];
          }
        }
        return [];
      }},

    // R6: client.ikmpsv — IK MPSV 10-digit modulo 11
    { id: 'R6', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'IK MPSV neodpovídá formátu.',
      check: function(ctx) {
        var ik = ctx.getVal('10051');
        if (!ik) return [];
        var result = validateIKMPSV(ik);
        if (!result.valid) return [{ fieldCsszId: '10051', message: ctx.rule.msg }];
        // If IK MPSV is filled for A1, RČ/EČP must also be filled
        var act = ctx.getVal('10008');
        if (act === '1' && !ctx.isFilled('10057'))
          return [{ fieldCsszId: '10057', message: 'Pokud je vyplněno IK MPSV pro A1, je nutné vyplnit také RČ/EČP.' }];
        return [];
      }},

    // R7: client.vcp — 9 digits, first = '6'
    { id: 'R7', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'VČP: neplatný formát.',
      check: function(ctx) {
        var v = ctx.getVal('10060');
        if (!v) return [];
        if (!/^\d{9}$/.test(v)) return [{ fieldCsszId: '10060', message: 'VČP musí obsahovat přesně 9 číslic.' }];
        if (v.charAt(0) !== '6') return [{ fieldCsszId: '10060', message: 'VČP: první číslice musí být 6.' }];
        return [];
      }},

    // R12: client.birth.dat — cross-check vs RČ; age ≥ 14 at job start (unless activity T-Z/ZA-ZC)
    { id: 'R12', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Datum narození: neplatné.',
      check: function(ctx) {
        var birthDat = ctx.getVal('10056');
        if (!birthDat || !/^\d{4}-\d{2}-\d{2}$/.test(birthDat)) return [];
        var errors = [];
        // Age check at job start
        var jobFro = ctx.getVal('10223');
        if (jobFro && /^\d{4}-\d{2}-\d{2}$/.test(jobFro)) {
          var bdp = parseDate(birthDat);
          var jfp = parseDate(jobFro);
          if (bdp && jfp && ageAt(bdp, jfp) < 14) {
            var rel = ctx.getVal('10239') || '';
            var exempt = ['T','U','V','W','X','Y','Z','ZA','ZB','ZC'];
            if (exempt.indexOf(rel) < 0) {
              errors.push({ fieldCsszId: '10056', message: 'Věk zaměstnance mladší 14 let — podání zamítnuto (nejedná-li se o druh činnosti T–Z, ZA–ZC).' });
            }
          }
        }
        return errors;
      }},

    // R57: comp.vs — Luhn algorithm for VS10
    { id: 'R57', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Variabilní symbol: neprošel Luhnovým algoritmem.',
      check: function(ctx) {
        var vs = ctx.getVal('10221');
        if (!vs) return [];
        if (vs.length === 10 && !luhnCheck(vs))
          return [{ fieldCsszId: '10221', message: ctx.rule.msg }];
        return [];
      }},

    // R58: comp.nvs — Luhn + nvs ≠ vs (A5 only)
    { id: 'R58', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Nový variabilní symbol: neplatný.',
      check: function(ctx) {
        var nvs = ctx.getVal('10222');
        if (!nvs) return [];
        var errors = [];
        if (nvs.length === 10 && !luhnCheck(nvs))
          errors.push({ fieldCsszId: '10222', message: 'Nový VS: neprošel Luhnovým algoritmem.' });
        var vs = ctx.getVal('10221');
        if (vs && nvs === vs)
          errors.push({ fieldCsszId: '10222', message: 'Nově vyplněný VS se nesmí shodovat s původním VS.' });
        return errors;
      }},

    // R66: job.sme — A/N; if A, rel must not be T-Z/ZA-ZC
    { id: 'R66', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Malý rozsah: neplatná hodnota.',
      check: function(ctx) {
        var v = ctx.getVal('10243');
        if (!v) return [];
        var be = checkBoolean(ctx, '10243');
        if (be.length > 0) return be;
        if (isTrueValue(v)) {
          var rel = ctx.getVal('10239') || '';
          var forbidden = ['T','U','V','W','X','Y','Z','ZA','ZB','ZC'];
          if (forbidden.indexOf(rel) >= 0)
            return [{ fieldCsszId: '10243', message: 'Malý rozsah nemůže být „A" pro druh činnosti ' + rel + '.' }];
        }
        return [];
      }},

    // R67: job.endbydeath — A/N; A1-OST/A4-OST: mandatory if 10224 filled; A2-OST: always mandatory
    // Z-side: merged from P/N/Z column control (originally R214)
    // CSV column 26 (Z): A1/A4: 10224 not filled → 10225 forbidden
    { id: 'R67', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Ukončeno smrtí: povinnostní podmínka.',
      check: function(ctx) {
        var v = ctx.getVal('10225');
        if (!v) {
          var act = ctx.getVal('10008');
          var rt = getRowType(ctx.emp);
          if (rt === 'OST') {
            if ((act === '1' || act === '4') && ctx.isFilled('10224'))
              return [{ fieldCsszId: '10225', message: 'Ukončeno smrtí musí být vyplněno, pokud je uvedeno datum skončení zaměstnání.' }];
            if (act === '2')
              return [{ fieldCsszId: '10225', message: 'Ukončeno smrtí musí být vyplněno pro akci A2.' }];
          }
          return [];
        }
        var errors = checkBoolean(ctx, '10225');
        // Z-side (from R214): A1/A4 OST: 10224 not filled → 10225 forbidden
        if (errors.length === 0) {
          var act2 = ctx.getVal('10008');
          var rt2 = getRowType(ctx.emp);
          if (rt2 === 'OST' && (act2 === '1' || act2 === '4') && !ctx.isFilled('10224'))
            return [{ fieldCsszId: '10225', message: 'Ukončeno smrtí nesmí být vyplněno, pokud datum skončení zaměstnání není vyplněno.' }];
        }
        return errors;
      }},

    // R68: job.notstart — A/N (A8 only per actions)
    { id: 'R68', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Zaměstnanec nenastoupil: neplatná hodnota.',
      check: function(ctx) {
        var v = ctx.getVal('10226');
        if (!v) return [];
        return checkBoolean(ctx, '10226');
      }},

    // R72: job.cont — A/N
    { id: 'R72', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Nepřetržitý provoz: neplatná hodnota.',
      check: function(ctx) {
        var v = ctx.getVal('10407');
        if (!v) return [];
        return checkBoolean(ctx, '10407');
      }},

    // R79: job.position.lead — A/N
    { id: 'R79', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Vedoucí zaměstnanec: neplatná hodnota.',
      check: function(ctx) {
        var v = ctx.getVal('10238');
        if (!v) return [];
        return checkBoolean(ctx, '10238');
      }},

    // R92: pens.early — A/N
    { id: 'R92', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Předčasný důchod: neplatná hodnota.',
      check: function(ctx) {
        var v = ctx.getVal('10115');
        if (!v) return [];
        return checkBoolean(ctx, '10115');
      }},

    // R125: forinreg.juris — A/N
    { id: 'R125', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Cizí právní předpisy: neplatná hodnota.',
      check: function(ctx) {
        var v = ctx.getVal('10427');
        if (!v) return [];
        return checkBoolean(ctx, '10427');
      }},

    // R131: pens.reducedAge — A/N
    { id: 'R131', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Snížený důchodový věk: neplatná hodnota.',
      check: function(ctx) {
        var v = ctx.getVal('10504');
        if (!v) return [];
        return checkBoolean(ctx, '10504');
      }},

    // R127: attachs — max 9, unique names, valid extensions, length limits, size limits
    { id: 'R127', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Přílohy: neplatné.',
      check: function(ctx) {
        if (!ctx.emp._empEl) return [];
        var attachsEl = findChildEl(ctx.emp._empEl, 'attachs');
        if (!attachsEl) return [];
        var errors = [];
        var attachEls = [];
        for (var i = 0; i < attachsEl.children.length; i++) {
          if (attachsEl.children[i].localName === 'attach') attachEls.push(attachsEl.children[i]);
        }
        if (attachEls.length > 9)
          errors.push({ message: 'Maximální počet příloh je 9 (nalezeno ' + attachEls.length + ').' });
        var validExts = ['.doc', '.docx', '.rtf', '.xls', '.xlsx', '.pdf', '.jpg', '.txt'];
        var names = {};
        var MAX_PER_FILE = 2 * 1024 * 1024;   // 2 MB
        var MAX_TOTAL    = 4 * 1024 * 1024;    // 4 MB
        var totalDataSize = 0;
        for (var j = 0; j < attachEls.length; j++) {
          var name = attachEls[j].getAttribute('name') || '';
          if (!name) {
            errors.push({ message: 'Příloha č. ' + (j + 1) + ': chybí název.' });
          } else {
            if (name.length > 100)
              errors.push({ message: 'Příloha č. ' + (j + 1) + ': název je delší než 100 znaků.' });
            if (names[name.toLowerCase()])
              errors.push({ message: 'Příloha „' + name + '": duplicitní název.' });
            names[name.toLowerCase()] = true;
            var dot = name.lastIndexOf('.');
            if (dot < 0) {
              errors.push({ message: 'Příloha „' + name + '": chybí přípona souboru.' });
            } else {
              var ext = name.substring(dot).toLowerCase();
              if (validExts.indexOf(ext) < 0)
                errors.push({ message: 'Příloha „' + name + '": nepodporovaný formát „' + ext + '".' });
            }
          }
          // Desc length check (optional attribute, max 100 chars)
          var desc = attachEls[j].getAttribute('desc') || '';
          if (desc.length > 100)
            errors.push({ message: 'Příloha č. ' + (j + 1) + ': popis je delší než 100 znaků.' });
          // R171: attach.data mandatory when attach element exists + size checks
          var data = attachEls[j].getAttribute('data') || '';
          if (!data) {
            errors.push({ message: 'Příloha č. ' + (j + 1) + ': chybí data.' });
          } else {
            // Estimate decoded size from base64 length (accurate enough for limit checks)
            var padding = 0;
            if (data.length >= 2 && data[data.length - 1] === '=') { padding++; if (data[data.length - 2] === '=') padding++; }
            var fileSize = Math.floor(data.length * 3 / 4) - padding;
            totalDataSize += fileSize;
            if (fileSize > MAX_PER_FILE)
              errors.push({ message: 'Příloha č. ' + (j + 1) + ': data překračují limit 2 MB.' });
          }
        }
        if (totalDataSize > MAX_TOTAL)
          errors.push({ message: 'Celková velikost příloh překračuje limit 4 MB.' });
        return errors;
      }},

    // Deprecated fields check — consolidated warning for 17 removed fields
    { id: 'RDEP', scope: 'emp', sev: 'warning', type: 'custom',
      msg: 'Nalezen zastaralý atribut.',
      check: function(ctx) {
        if (!ctx.emp._empEl) return [];
        var errors = [];
        var deprecated = [
          { parent: 'client/adr', attr: 'pos', label: 'R23 adr.pos' },
          { parent: 'client/fdr', attr: 'pos', label: 'R31 fdr.pos' },
          { parent: 'client/cdr', attr: 'pos', label: 'R39 cdr.pos' },
          { parent: 'client/proofid', attr: 'issuedate', label: 'R55 proofid.issuedate' },
          { parent: 'client/proofid', attr: 'expdate', label: 'R56 proofid.expdate' },
          { parent: 'job', attr: 'per', label: 'R65 job.per' },
          { parent: 'job/prof', attr: 'dific', label: 'R75 job.prof.dific' },
          { parent: 'job/position', attr: 'fro', label: 'R78 job.position.fro' },
          { parent: 'unemplcomp', attr: 'mltincomeA', label: 'R101 unemplcomp.mltincomeA' },
          { parent: 'unemplcomp', attr: 'mltincomeB', label: 'R102 unemplcomp.mltincomeB' },
          { parent: 'unemplcomp', attr: 'mltincomeZPA', label: 'R103 unemplcomp.mltincomeZPA' },
          { parent: 'unemplcomp', attr: 'mltincomeZPB', label: 'R104 unemplcomp.mltincomeZPB' },
          { parent: 'fact', attr: 'chldcare', label: 'R109 fact.chldcare' },
          { parent: 'fact', attr: 'penben', label: 'R110 fact.penben' },
          { parent: 'fact', attr: 'reduc', label: 'R132 fact.reduc' },
          { parent: 'nocitizen', attr: 'permext', label: 'R123 nocitizen.permext' },
          { parent: 'nocitizen', attr: 'chngoblig', label: 'R124 nocitizen.chngoblig' }
        ];
        var empEl = ctx.emp._empEl;
        deprecated.forEach(function (d) {
          var parts = d.parent.split('/');
          var el = empEl;
          for (var i = 0; i < parts.length; i++) {
            el = findChildEl(el, parts[i]);
            if (!el) break;
          }
          if (el && el.hasAttribute(d.attr)) {
            var val = el.getAttribute(d.attr);
            if (val !== '')
              errors.push({ message: 'Zastaralý atribut „' + d.label + '" nalezen v XML (hodnota: „' + val + '"). Tento atribut byl odstraněn ze schématu.' });
          }
        });
        return errors;
      }},

    // ═══ Phase 2: Address completeness + format rules ═══

    // --- TRVA group (client/adr): R18, R19, R20, R21, R22 ---

    // R18: adr.str — if filled, other TRVA fields must be filled
    { id: 'R18', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Trvalé bydliště – ulice: ostatní údaje adresy musí být vyplněny.',
      check: function(ctx) {
        if (!ctx.isFilled('10077')) return [];
        var mandatory = ['10078', '10082', '10080', '10083'];
        var missing = mandatory.filter(function (id) { return !ctx.isFilled(id); });
        if (missing.length > 0)
          return [{ fieldCsszId: missing[0], message: 'Je-li vyplněna ulice, pak musí být vyplněny i ostatní údaje trvalé adresy.' }];
        return [];
      }},

    // R19: adr.num — CZ: 0-4 digits only; Kontrola 1 TRVA (address completeness)
    { id: 'R19', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Trvalé bydliště – číslo popisné: neplatné.',
      check: function(ctx) {
        var errors = [];
        var num = ctx.getVal('10078');
        if (num) {
          var cnt = ctx.getVal('10083') || '';
          if (cnt === 'CZ') {
            if (!/^\d{1,4}$/.test(num))
              errors.push({ fieldCsszId: '10078', message: 'Číslo popisné (trvalé bydliště): pro CZ musí být 1–4 číslice.' });
          }
        }
        // Kontrola 1 TRVA: if any of group filled → all mandatory
        var act = ctx.getVal('10008');
        if (act === '3' || act === '4') {
          var groupFields = ['10078', '10082', '10080', '10083'];
          var anyFilled = groupFields.some(function (id) { return ctx.isFilled(id); });
          if (anyFilled && !ctx.isFilled('10078'))
            errors.push({ fieldCsszId: '10078', message: 'Kontrola 1 TRVA: číslo popisné je povinné, pokud je vyplněn jiný údaj adresy.' });
        }
        return errors;
      }},

    // R20: adr.onum — CZ: 0-4; non-CZ: 0-12
