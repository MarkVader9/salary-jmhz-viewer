    { id: 'R209', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Platnost změny od: povinnostní podmínka.',
      check: function(ctx) {
        var act = ctx.getVal('10008');
        if (act !== '3' && act !== '4') return [];
