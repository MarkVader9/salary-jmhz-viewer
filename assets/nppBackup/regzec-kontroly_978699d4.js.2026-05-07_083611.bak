        if (rt !== 'OST' && rt !== 'SPEC') return [];
        // P-side: 10106 filled → 10109 mandatory
        if (ctx.isFilled('10106') && !ctx.isFilled('10109'))
          return [{ fieldCsszId: '10109', message: 'Oprávnění od je povinné, pokud je vyplněn druh pracovního oprávnění.' }];
        // Z-side: 10106 not filled → 10109 forbidden
        if (!ctx.isFilled('10106') && ctx.isFilled('10109'))
          return [{ fieldCsszId: '10109', message: 'Oprávnění od nesmí být vyplněno, pokud druh pracovního oprávnění není vyplněn.' }];
