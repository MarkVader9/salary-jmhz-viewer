    // ═══ Phase 3: Cross-field & date comparisons ═══

    // R62: job.fro — CZ: <= dat vyplnění; non-CZ: < 9 days after; age; 2026 cutoff
    { id: 'R62', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Datum nástupu do zaměstnání: neplatné.',
      check: function(ctx) {
        var jobFro = ctx.getVal('10223');
        if (!jobFro || !/^\d{4}-\d{2}-\d{2}$/.test(jobFro)) return [];
        var errors = [];
        var datVyplneni = ctx.getVal('10005') || '';
        var cnt = ctx.getVal('10067') || '';
        // CZ → job.fro <= date of form
        if (cnt === 'CZ' && datVyplneni && jobFro > datVyplneni)
          errors.push({ fieldCsszId: '10223', message: 'Datum nástupu nesmí být pozdější než datum vyplnění (občanství CZ).' });
        // Non-CZ → job.fro must not be >= 9 calendar days after date of form
        if (cnt && cnt !== 'CZ' && datVyplneni) {
          var dvp = parseDate(datVyplneni);
          if (dvp) {
            var limit = formatDate(addDays(dvp, 9));
            if (jobFro >= limit)
              errors.push({ fieldCsszId: '10223', message: 'Datum nástupu nesmí být ≥ 9 kal. dnů po datu vyplnění (občanství ≠ CZ).' });
          }
        }
        // Age check
        var birthDat = ctx.getVal('10056');
        if (birthDat && /^\d{4}-\d{2}-\d{2}$/.test(birthDat)) {
          var bdp = parseDate(birthDat);
          var jfp = parseDate(jobFro);
          if (bdp && jfp && ageAt(bdp, jfp) < 14) {
            var rel = ctx.getVal('10239') || '';
            var exempt = ['T','U','V','W','X','Y','Z','ZA','ZB','ZC'];
            if (exempt.indexOf(rel) < 0)
              errors.push({ fieldCsszId: '10223', message: 'Věk zaměstnance mladší 14 let ke dni nástupu.' });
          }
        }
        // 2026 cutoff: rel=10..16 or relDetail=2 → job.fro >= 2026-01-01
        var rel2 = ctx.getVal('10239') || '';
        var relDetail = ctx.getVal('10502') || '';
        var relNum = parseInt(rel2, 10);
        if ((relNum >= 10 && relNum <= 16) || relDetail === '2') {
          if (jobFro < '2026-01-01')
            errors.push({ fieldCsszId: '10223', message: 'Pro druh činnosti 10–16 nebo bližší určení PPV = 2: datum nástupu musí být ≥ 1.1.2026.' });
        }
        return errors;
      }},

    // R63: job.to — >= job.fro AND <= dat vyplnění
    { id: 'R63', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Datum skončení zaměstnání: neplatné.',
      check: function(ctx) {
        var jobTo = ctx.getVal('10224');
        if (!jobTo) return [];
        var errors = [];
        var jobFro = ctx.getVal('10223');
        if (jobFro && jobTo < jobFro)
          errors.push({ fieldCsszId: '10224', message: 'Datum skončení nesmí být dřívější než datum nástupu.' });
        var dat = ctx.getVal('10005');
        if (dat && jobTo > dat)
          errors.push({ fieldCsszId: '10224', message: 'Datum skončení nesmí být pozdější než datum vyplnění.' });
        return errors;
      }},

    // R91: pens.tak — <= dat vyplnění; mutual pair with pens.typ
    { id: 'R91', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Důchod pobírán od: neplatné.',
      check: function(ctx) {
        var errors = [];
        var tak = ctx.getVal('10114');
        if (tak) {
          var dat = ctx.getVal('10005');
          if (dat && tak > dat)
            errors.push({ fieldCsszId: '10114', message: 'Důchod pobírán od nesmí být pozdější než datum vyplnění.' });
        }
        // Mutual pair: if pens.typ filled → pens.tak mandatory
        if (ctx.isFilled('10113') && !ctx.isFilled('10114'))
          errors.push({ fieldCsszId: '10114', message: 'Je-li uveden druh důchodu, musí být uvedeno i datum pobírání.' });
        // Reverse: if pens.tak filled → pens.typ mandatory
        if (ctx.isFilled('10114') && !ctx.isFilled('10113'))
          errors.push({ fieldCsszId: '10113', message: 'Je-li uvedeno datum pobírání důchodu, musí být uveden i druh důchodu.' });
        return errors;
      }},

    // R99: pensionperiod.to >= pensionperiod.fro (within same instance); Kontrola 3 obligation
    { id: 'R99', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Doba důchodového pojištění do: neplatné.',
      check: function(ctx) {
        var n = ctx.getRepeatCount('unemplcomp/pensionperiod');
        var errors = [];
        var obligatory = isKontrola3Obligatory(ctx.emp, negBase(ctx.emp));
        for (var i = 0; i < n; i++) {
          var fro = ctx.getVal('10386', i);
          var to = ctx.getVal('10387', i);
          if (fro && to && to < fro)
            errors.push({ fieldCsszId: '10387', instanceIndex: i, message: 'Pojištění do nesmí být dřívější než pojištění od.' });
          if (obligatory && fro && !to)
            errors.push({ fieldCsszId: '10387', instanceIndex: i, message: 'Doba důchodového pojištění do je povinná.' });
        }
        return errors;
      }},

    // R114: healtrest.fro — if 10085 filled → mandatory; fro < to; fro < dat vyplnění (strict)
    { id: 'R114', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Zdravotní omezení od: neplatné.',
      check: function(ctx) {
        var errors = [];
        if (ctx.isFilled('10085') && !ctx.isFilled('10086'))
          errors.push({ fieldCsszId: '10086', message: 'Zdravotní omezení od je povinné, pokud je uveden typ.' });
        var fro = ctx.getVal('10086');
        if (fro) {
          var to = ctx.getVal('10087');
          if (to && fro >= to)
            errors.push({ fieldCsszId: '10086', message: 'Zdravotní omezení od musí být menší než do.' });
          var dat = ctx.getVal('10005');
          if (dat && fro >= dat)
            errors.push({ fieldCsszId: '10086', message: 'Zdravotní omezení od musí být menší než datum vyplnění.' });
        }
        return errors;
      }},

    // R115: healtrest.to — if fro not filled → must be empty; to > fro
    { id: 'R115', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Zdravotní omezení do: neplatné.',
      check: function(ctx) {
        var to = ctx.getVal('10087');
        if (to && !ctx.isFilled('10086'))
          return [{ fieldCsszId: '10087', message: 'Zdravotní omezení do nemůže být vyplněno, pokud není uvedeno od.' }];
        if (to) {
          var fro = ctx.getVal('10086');
          if (fro && to <= fro)
            return [{ fieldCsszId: '10087', message: 'Zdravotní omezení do musí být větší než od.' }];
        }
        return [];
      }},

    // R121: nocitizen.permfro — if 10106 filled → mandatory; permfro < permto; permfro <= dat
    { id: 'R121', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Oprávnění od: neplatné.',
      check: function(ctx) {
        var errors = [];
        if (ctx.isFilled('10106') && !ctx.isFilled('10109'))
          errors.push({ fieldCsszId: '10109', message: 'Oprávnění od je povinné, pokud je uveden druh pracovního oprávnění.' });
        var fro = ctx.getVal('10109');
        if (fro) {
          var to = ctx.getVal('10110');
          if (to && fro >= to)
            errors.push({ fieldCsszId: '10109', message: 'Oprávnění od musí být menší než oprávnění do.' });
          var dat = ctx.getVal('10005');
          if (dat && fro > dat)
            errors.push({ fieldCsszId: '10109', message: 'Oprávnění od musí být ≤ datum vyplnění.' });
        }
        return errors;
      }},

    // R122: nocitizen.permto — if permfro not filled → must be empty; permto > permfro
    { id: 'R122', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Oprávnění do: neplatné.',
      check: function(ctx) {
        var to = ctx.getVal('10110');
        if (to && !ctx.isFilled('10109'))
          return [{ fieldCsszId: '10110', message: 'Oprávnění do nemůže být vyplněno, pokud není uvedeno od.' }];
        if (to) {
          var fro = ctx.getVal('10109');
          if (fro && to <= fro)
            return [{ fieldCsszId: '10110', message: 'Oprávnění do musí být větší než od.' }];
        }
        return [];
      }},

    // ═══ Phase 4: Conditional obligation / PP fields ═══

    // R47: taxidrezid.type — 10068 ≠ CZ → mandatory; 10068 = CZ → must not be filled
    { id: 'R47', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Typ daňové identifikace: neplatné.',
      check: function(ctx) {
        var stat = ctx.getVal('10068') || '';
        if (stat && stat !== 'CZ' && !ctx.isFilled('10061'))
          return [{ fieldCsszId: '10061', message: 'Typ daňové identifikace je povinný, pokud kód státu rezidentství ≠ CZ.' }];
        if ((!stat || stat === 'CZ') && ctx.isFilled('10061'))
          return [{ fieldCsszId: '10061', message: 'Typ daňové identifikace nesmí být vyplněn, pokud kód státu rezidentství = CZ.' }];
        return [];
      }},

    // R48: taxidrezid.num — same conditional as R47
    { id: 'R48', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Daňový identifikátor: neplatné.',
      check: function(ctx) {
        var stat = ctx.getVal('10068') || '';
        if (stat && stat !== 'CZ' && !ctx.isFilled('10062'))
          return [{ fieldCsszId: '10062', message: 'Daňový identifikátor je povinný, pokud kód státu rezidentství ≠ CZ.' }];
        if ((!stat || stat === 'CZ') && ctx.isFilled('10062'))
          return [{ fieldCsszId: '10062', message: 'Daňový identifikátor nesmí být vyplněn, pokud kód státu rezidentství = CZ.' }];
        return [];
      }},

    // R50: taxidrezid.statchang — A3/A4 OST/SPEC: PP on 10068↔10459
    { id: 'R50', scope: 'emp', sev: 'error', type: 'custom',
      msg: 'Platnost změny od: neplatné.',
      check: function(ctx) {
        var act = ctx.getVal('10008');
        if (act !== '3' && act !== '4') return [];
        var rt = getRowType(ctx.emp);
        if (rt !== 'OST' && rt !== 'SPEC') return [];
        // P-side: 10068 filled → 10459 mandatory
        if (ctx.isFilled('10068') && !ctx.isFilled('10459'))
          return [{ fieldCsszId: '10459', message: 'Platnost změny od je povinná, pokud je vyplněn kód státu rezidentství.' }];
        // Z-side: 10068 not filled → 10459 forbidden
        if (!ctx.isFilled('10068') && ctx.isFilled('10459'))
          return [{ fieldCsszId: '10459', message: 'Platnost změny od nesmí být vyplněna bez vyplnění kódu státu rezidentství.' }];
        return [];
      }},

    // R51: proofid.type — if 10067 ≠ CZ → mandatory
    { id: 'R51', scope: 'emp', sev: 'error', type: 'custom',
