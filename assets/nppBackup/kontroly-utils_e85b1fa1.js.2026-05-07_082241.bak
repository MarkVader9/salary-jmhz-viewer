// === Shared Kontroly Utilities ===
// Generic infrastructure shared by mh-kontroly.js (JMHZ) and regzec-kontroly.js (REG-ZEC).
// Loaded before both kontroly files via embed.js.

(function () {
  'use strict';

  // ── Field resolver: csszId → value from employee mirror ──────
  let _csszIdToField = null;    // Map<csszId, fieldDef>

  function buildCsszIndex(fields) {
    _csszIdToField = new Map();
    fields.forEach(function (f) { if (f.csszId) _csszIdToField.set(f.csszId, f); });
  }

  function fieldKeyFor(field, instanceIndex) {
    var attrKey = field.element || field.attr;
    if (instanceIndex !== undefined) return field.section + '[' + instanceIndex + ']/' + attrKey;
    return field.section + '/' + attrKey;
  }

  // Get raw string value by csszId from employee mirror
  function getVal(emp, csszId, instanceIndex) {
    var f = _csszIdToField.get(csszId);
    if (!f) return undefined;
    var key = fieldKeyFor(f, instanceIndex);
    return emp.fields[key]?.value || '';
  }

  // Get numeric value (null if empty/NaN)
  function getNum(emp, csszId, instanceIndex) {
    var v = getVal(emp, csszId, instanceIndex);
    if (v === '' || v === undefined) return null;
    var n = parseFloat(String(v).replace(/\s/g, '').replace(',', '.'));
    return isNaN(n) ? null : n;
  }

  // Check if field is filled (non-empty)
  function isFilled(emp, csszId, instanceIndex) {
    var v = getVal(emp, csszId, instanceIndex);
    return v !== '' && v !== undefined && v !== null;
  }

  // Get field definition by csszId
  function getFieldDef(csszId) { return _csszIdToField?.get(csszId) || null; }

  // Get field label for error messages
  function getFieldLabel(csszId) { return getFieldDef(csszId)?.label || csszId; }

  // Get section label for a csszId
  function getSectionLabel(csszId) {
    var f = getFieldDef(csszId);
    if (!f) return '';
    return (typeof SECTION_MAP !== 'undefined' && SECTION_MAP[f.section])
      ? SECTION_MAP[f.section].label : f.section;
  }

  // Get all instances of a repeating section for an employee
  function getRepeatCount(emp, sectionId) {
    return emp._instanceCounts?.[sectionId] || 0;
  }

  // ── Boolean parsing ─────────────────────────────────────────

  var TRUE_BOOLEAN_VALUES = new Set(['A', 'ANO', 'TRUE', '1']);
  var FALSE_BOOLEAN_VALUES = new Set(['N', 'NE', 'FALSE', '0']);

  function isTrueValue(value) {
    return TRUE_BOOLEAN_VALUES.has(String(value || '').trim().toUpperCase());
  }

  function isFalseValue(value) {
    return FALSE_BOOLEAN_VALUES.has(String(value || '').trim().toUpperCase());
  }

  // ── DOM helpers ─────────────────────────────────────────────

  function findChildEl(parent, localName) {
    if (!parent) return null;
    for (var i = 0; i < parent.children.length; i++) {
      if (parent.children[i].localName === localName) return parent.children[i];
    }
    return null;
  }

  // ── DSL Rule Interpreter ────────────────────────────────────

  function evalRule(rule, emp, headerFields, allEmps, opts) {
    var errors = [];
    var sev = rule.sev || 'error';
    var getHeaderValFn = opts && opts.getHeaderVal;
    var getHeaderNumFn = opts && opts.getHeaderNum;

    function pushError(msg, csszId, instanceIndex) {
      errors.push({
        severity: sev,
        controlId: rule.id,
        fieldCsszId: csszId || rule.target || (rule.fields && rule.fields[0]) || '',
        instanceIndex: instanceIndex,
        message: msg || rule.msg
      });
    }

    // Pre-condition: if `cond` is specified, skip rule if condition not met
    if (rule.cond) {
      var cv = getVal(emp, rule.cond.field);
      if (rule.cond.op === '>' && !(getNum(emp, rule.cond.field) > (rule.cond.val || 0))) return errors;
      if (rule.cond.op === '=' && cv !== String(rule.cond.val)) return errors;
      if (rule.cond.op === '!=' && cv === String(rule.cond.val)) return errors;
      if (rule.cond.op === 'filled' && !isFilled(emp, rule.cond.field)) return errors;
      if (rule.cond.op === 'empty' && isFilled(emp, rule.cond.field)) return errors;
      if (rule.cond.op === 'in') {
        if (!rule.cond.vals || !rule.cond.vals.includes(cv)) return errors;
      }
    }

    switch (rule.type) {
      case 'sum_eq': {
        var target = getNum(emp, rule.target);
        if (target === null) break;
        var sum = rule.parts.reduce(function (s, id) { return s + (getNum(emp, id) || 0); }, 0);
        if (Math.abs(target - sum) > 0.001) pushError(rule.msg, rule.target);
        break;
      }

      case 'sum_gte': {
        var target2 = getNum(emp, rule.target);
        if (target2 === null) break;
        var sum2 = rule.parts.reduce(function (s, id) { return s + (getNum(emp, id) || 0); }, 0);
        if (target2 < sum2 - 0.001) pushError(rule.msg, rule.target);
        break;
      }

      case 'gte': {
        var a = getNum(emp, rule.a);
        var b = getNum(emp, rule.b);
        if (a === null || b === null) break;
        if (a < b - 0.001) pushError(rule.msg, rule.a);
        break;
      }

      case 'lte': {
        var a2 = getNum(emp, rule.a);
        var b2 = getNum(emp, rule.b);
        if (a2 === null || b2 === null) break;
        if (a2 > b2 + 0.001) pushError(rule.msg, rule.a);
        break;
      }

      case 'eq': {
        var a3 = getNum(emp, rule.a);
        var b3 = getNum(emp, rule.b);
        if (a3 === null || b3 === null) break;
        if (Math.abs(a3 - b3) > 0.001) pushError(rule.msg, rule.a);
        break;
      }

      case 'non_neg': {
        var v = getNum(emp, rule.field);
        if (v === null) break;
        if (v < 0) pushError(rule.msg, rule.field);
        break;
      }

      case 'range': {
        var v2 = getNum(emp, rule.field);
        if (v2 === null) break;
        if ((rule.min !== undefined && v2 < rule.min) || (rule.max !== undefined && v2 > rule.max))
          pushError(rule.msg, rule.field);
        break;
      }

      case 'pct_eq': {
        var target3 = getNum(emp, rule.target);
        var base = getNum(emp, rule.base);
        if (target3 === null || base === null) break;
        var expected = Math.ceil(rule.rate * base);
        if (Math.abs(target3 - expected) > 0.5) pushError(rule.msg, rule.target);
        break;
      }

      case 'if_then_required': {
        if (!evalCondition(emp, rule.condition)) break;
        var missing = rule.fields.filter(function (id) { return !isFilled(emp, id); });
        if (missing.length > 0) pushError(rule.msg, missing[0]);
        break;
      }

      case 'if_then_empty': {
        if (!evalCondition(emp, rule.condition)) break;
        var present = rule.fields.filter(function (id) { return isFilled(emp, id); });
        if (present.length > 0) pushError(rule.msg, present[0]);
        break;
      }

      case 'date_lte': {
        var a4 = getVal(emp, rule.a);
        var b4 = getVal(emp, rule.b);
        if (!a4 || !b4) break;
        if (a4 > b4) pushError(rule.msg, rule.a);
        break;
      }

      case 'custom': {
        if (typeof rule.check === 'function') {
          var ctx = {
            getVal: function (id, ii) { return getVal(emp, id, ii); },
            getNum: function (id, ii) { return getNum(emp, id, ii); },
            isFilled: function (id, ii) { return isFilled(emp, id, ii); },
            getHeaderVal: getHeaderValFn || function () { return ''; },
            getHeaderNum: getHeaderNumFn || function () { return null; },
            allEmps: allEmps, headerFields: headerFields, emp: emp, rule: rule,
            getRepeatCount: function (secId) { return getRepeatCount(emp, secId); },
            getFieldLabel: getFieldLabel,
            // Codelists — see codelists-client.js / window.JMHZCodelists.
            // inCodelist returns 'valid' | 'expired' | 'unknown' | 'data-unavailable'.
            inCodelist: function (code, value, atDate) {
              return (typeof window !== 'undefined' && window.JMHZCodelists)
                ? window.JMHZCodelists.inCodelist(code, value, atDate) : 'data-unavailable';
            },
            inCodelistByName: function (code, name, atDate) {
              return (typeof window !== 'undefined' && window.JMHZCodelists)
                ? window.JMHZCodelists.inCodelistByName(code, name, atDate) : 'data-unavailable';
            },
            inCodelistByAbbrev: function (code, abbrev, atDate) {
              return (typeof window !== 'undefined' && window.JMHZCodelists)
                ? window.JMHZCodelists.inCodelistByAbbrev(code, abbrev, atDate) : 'data-unavailable';
            },
            codelistDataAvailable: function (code) {
              return (typeof window !== 'undefined' && window.JMHZCodelists)
                ? window.JMHZCodelists.codelistDataAvailable(code) : false;
            }
          };
          var customErrors = rule.check(ctx);
          if (customErrors && customErrors.length > 0) {
            customErrors.forEach(function (ce) {
              errors.push({
                severity: ce.severity || sev,
                controlId: rule.id,
                fieldCsszId: ce.fieldCsszId || '',
                instanceIndex: ce.instanceIndex,
                message: ce.message || rule.msg
              });
            });
          }
        }
        break;
      }
    }

    return errors;
  }

  // Evaluate a condition object: { field, op, val/vals }
  function evalCondition(emp, cond) {
    if (!cond) return true;
    var v = getVal(emp, cond.field);
    var n = getNum(emp, cond.field);
    switch (cond.op) {
      case '=': return v === String(cond.val);
      case '!=': return v !== String(cond.val);
      case '>': return n !== null && n > (cond.val || 0);
      case '>=': return n !== null && n >= (cond.val || 0);
      case '<': return n !== null && n < (cond.val || 0);
      case 'filled': return isFilled(emp, cond.field);
      case 'empty': return !isFilled(emp, cond.field);
      case 'in': return cond.vals && cond.vals.includes(v);
      case 'not_in': return !cond.vals || !cond.vals.includes(v);
      default: return true;
    }
  }

  // ── Validation Algorithms ───────────────────────────────────

  // RČ (rodné číslo) modulo 11 check
  // Input: raw string (may contain slash). Returns { valid, digits, error? }
  function validateRCModulo11(rc) {
    if (!rc) return { valid: false, error: 'empty' };
    var digits = rc.replace(/\//g, '');
    if (!/^\d{9,10}$/.test(digits)) return { valid: false, digits: digits, error: 'format' };
    if (digits.length === 10) {
      var num = parseInt(digits, 10);
      if (num % 11 !== 0) return { valid: false, digits: digits, error: 'modulo' };
    }
    return { valid: true, digits: digits };
  }

  // IK MPSV modulo 11 check
  // Input: raw string. Returns { valid, error? }
  function validateIKMPSV(ik) {
    if (!ik) return { valid: false, error: 'empty' };
    if (!/^\d{10}$/.test(ik)) return { valid: false, error: 'format' };
    var num = parseInt(ik.substring(0, 9), 10);
    if (isNaN(num)) return { valid: false, error: 'format' };
    var remainder = num % 11;
    var check = remainder >= 10 ? 0 : remainder;
    if (parseInt(ik.charAt(9), 10) !== check) return { valid: false, error: 'modulo' };
    return { valid: true };
  }

  // Luhn algorithm (used for VS10 variabilní symbol)
  // Input: string of digits. Returns true if valid.
  function luhnCheck(digits) {
    if (!digits || !/^\d+$/.test(digits)) return false;
    var sum = 0;
    var alternate = false;
    for (var i = digits.length - 1; i >= 0; i--) {
      var n = parseInt(digits.charAt(i), 10);
      if (alternate) {
        n *= 2;
        if (n > 9) n -= 9;
      }
      sum += n;
      alternate = !alternate;
    }
    return sum % 10 === 0;
  }

  // CZ PSČ format validation: 5 digits, first digit ≠ 0, 8, 9
  function validateCzPsc(psc) {
    if (!psc) return { valid: false, error: 'empty' };
    var clean = psc.replace(/\s/g, '');
    if (!/^\d{5}$/.test(clean)) return { valid: false, error: 'format' };
    var first = clean.charAt(0);
    if (first === '0' || first === '8' || first === '9') return { valid: false, error: 'range' };
    return { valid: true };
  }

  // ── Timezone-safe date helpers ──────────────────────────────
  // All date strings are expected in 'YYYY-MM-DD' format.

  // Parse 'YYYY-MM-DD' → {y, m, d} or null
  function parseDate(str) {
    if (!str || str.length < 10) return null;
    var s = str.substring(0, 10);
    var parts = s.split('-');
    if (parts.length !== 3) return null;
    var y = parseInt(parts[0], 10), m = parseInt(parts[1], 10), d = parseInt(parts[2], 10);
    if (isNaN(y) || isNaN(m) || isNaN(d)) return null;
    return { y: y, m: m, d: d };
  }

  // Compare two {y,m,d} objects. Returns <0 if a<b, 0 if equal, >0 if a>b.
  function compareDates(a, b) {
    return (a.y - b.y) || (a.m - b.m) || (a.d - b.d);
  }

  // Add n days to a {y,m,d} and return new {y,m,d}. Uses UTC internally.
  function addDays(dt, n) {
    var ms = Date.UTC(dt.y, dt.m - 1, dt.d) + n * 86400000;
    var u = new Date(ms);
    return { y: u.getUTCFullYear(), m: u.getUTCMonth() + 1, d: u.getUTCDate() };
  }

  // Days in month (1-indexed month)
  function daysInMonth(year, month) {
    return new Date(Date.UTC(year, month, 0)).getUTCDate();
  }

  // Format {y,m,d} → 'YYYY-MM-DD'
  function formatDate(dt) {
    var mm = dt.m < 10 ? '0' + dt.m : '' + dt.m;
    var dd = dt.d < 10 ? '0' + dt.d : '' + dt.d;
    return dt.y + '-' + mm + '-' + dd;
  }

  // Today as {y,m,d}
  function todayDate() {
    var n = new Date();
    return { y: n.getFullYear(), m: n.getMonth() + 1, d: n.getDate() };
  }

  // Compute age at a given date. Returns integer years.
  function ageAt(birth, at) {
    var age = at.y - birth.y;
    if (at.m < birth.m || (at.m === birth.m && at.d < birth.d)) age--;
    return age;
  }

  // Create {y,m,d} from numeric components (for year/month/day arithmetic)
  function makeDate(y, m, d) {
    return { y: y, m: m, d: d };
  }

  // Reset index on format change
  function resetKontrolyIndex() {
    _csszIdToField = null;
  }

  // ── Sanitizer: prune empty optional elements/attributes ─────
  // Operates on a CLONE — the live xmlDoc is never mutated.
  //
  // meta = {
  //   optionalChildren: { parentLocalName: [childLocalName, …] },
  //   optionalAttrs:    { elementLocalName: [attrLocalName, …] } | null
  // }
  //
  // touchedNodes (optional): a Set of original-DOM Nodes whose values were
  // edited by the user.  When provided, only elements/attributes that map to
  // a touched node are candidates for pruning.  Passing null/undefined falls
  // back to the original "prune everything empty" behavior.
  function sanitizeEmptyXml(doc, meta, touchedNodes) {
    if (!doc || !meta) return doc;
    var clone = doc.cloneNode(true);
    var optChildren = meta.optionalChildren || {};
    var optAttrs = meta.optionalAttrs || null;

    // Pre-build Sets for O(1) lookup
    var optChildSets = {};
    for (var key in optChildren) {
      if (optChildren.hasOwnProperty(key)) {
        optChildSets[key] = {};
        for (var ci = 0; ci < optChildren[key].length; ci++) {
          optChildSets[key][optChildren[key][ci]] = true;
        }
      }
    }
    var optAttrSets = null;
    if (optAttrs) {
      optAttrSets = {};
      for (var akey in optAttrs) {
        if (optAttrs.hasOwnProperty(akey)) {
          optAttrSets[akey] = {};
          for (var ai = 0; ai < optAttrs[akey].length; ai++) {
            optAttrSets[akey][optAttrs[akey][ai]] = true;
          }
        }
      }
    }

    function getChildElements(el) {
      var result = [];
      for (var i = 0; i < el.childNodes.length; i++) {
        if (el.childNodes[i].nodeType === 1) result.push(el.childNodes[i]);
      }
      return result;
    }

    function isOptionalChild(el) {
      var parent = el.parentNode;
      if (!parent || parent.nodeType !== 1) return false;
      var set = optChildSets[parent.localName];
      return set ? (set[el.localName] === true) : false;
    }

    function pruneEmptyAttrs(el) {
      if (!optAttrSets) return;
      var set = optAttrSets[el.localName];
      if (!set) return;
      var toRemove = [];
      for (var i = 0; i < el.attributes.length; i++) {
        var attr = el.attributes[i];
        if (set[attr.localName] && (attr.value || '').trim() === '') {
          toRemove.push(attr.localName);
        }
      }
      for (var r = 0; r < toRemove.length; r++) {
        el.removeAttribute(toRemove[r]);
      }
    }

    // Recursive check: true when the entire subtree (element + all descendants)
    // contains no meaningful data (no non-empty text, no non-empty non-xmlns attrs).
    // This enables pruning an optional parent whose required children are all empty.
    function isSubtreeEmpty(el) {
      // Check own direct text nodes (not child element text)
      for (var t = 0; t < el.childNodes.length; t++) {
        var node = el.childNodes[t];
        if (node.nodeType === 3 && node.nodeValue && node.nodeValue.trim() !== '') return false;
      }
      // Check attributes
      for (var a = 0; a < el.attributes.length; a++) {
        var attr = el.attributes[a];
        if (attr.name === 'xmlns' || attr.name.indexOf('xmlns:') === 0) continue;
        if ((attr.value || '').trim() !== '') return false;
      }
      // Recurse into child elements
      var children = getChildElements(el);
      for (var c = 0; c < children.length; c++) {
        if (!isSubtreeEmpty(children[c])) return false;
      }
      return true;
    }

    function walk(el) {
      var children = getChildElements(el);
      for (var i = 0; i < children.length; i++) {
        walk(children[i]);
      }
      pruneEmptyAttrs(el);
      if (el === clone.documentElement) return;
      if (isSubtreeEmpty(el)) {
        if (isOptionalChild(el)) {
          // Always prune optional empty elements (leaf or container).
          el.parentNode.removeChild(el);
        } else {
          // For required elements, only prune empty LEAF elements that are
          // pure value holders (no child elements, no non-xmlns attributes).
          // This converts confusing XSD type errors (e.g. "'' is not valid
          // xs:boolean") into clearer "missing required child" errors.
          // Skip REGZEC-style container elements that carry attributes.
          var isLeaf = getChildElements(el).length === 0;
          var hasAttrs = false;
          for (var a = 0; a < el.attributes.length; a++) {
            var an = el.attributes[a].name;
            if (an !== 'xmlns' && an.indexOf('xmlns:') !== 0) { hasAttrs = true; break; }
          }
          if (isLeaf && !hasAttrs) {
            el.parentNode.removeChild(el);
          }
        }
      }
    }

    walk(clone.documentElement);
    return clone;
  }

  // ── Export ───────────────────────────────────────────────────
  window.KontrolyUtils = {
    buildCsszIndex: buildCsszIndex,
    fieldKeyFor: fieldKeyFor,
    getVal: getVal,
    getNum: getNum,
    isFilled: isFilled,
    getFieldDef: getFieldDef,
    getFieldLabel: getFieldLabel,
    getSectionLabel: getSectionLabel,
    getRepeatCount: getRepeatCount,
    TRUE_BOOLEAN_VALUES: TRUE_BOOLEAN_VALUES,
    FALSE_BOOLEAN_VALUES: FALSE_BOOLEAN_VALUES,
    isTrueValue: isTrueValue,
    isFalseValue: isFalseValue,
    findChildEl: findChildEl,
    evalRule: evalRule,
    evalCondition: evalCondition,
    validateRCModulo11: validateRCModulo11,
    validateIKMPSV: validateIKMPSV,
    luhnCheck: luhnCheck,
    validateCzPsc: validateCzPsc,
    resetKontrolyIndex: resetKontrolyIndex,
    parseDate: parseDate,
    compareDates: compareDates,
    addDays: addDays,
    daysInMonth: daysInMonth,
    formatDate: formatDate,
    todayDate: todayDate,
    ageAt: ageAt,
    makeDate: makeDate,
    sanitizeEmptyXml: sanitizeEmptyXml,
    _injectFieldDef: function(csszId, def) { if (_csszIdToField) _csszIdToField.set(csszId, def); },
    _removeFieldDef: function(csszId) { if (_csszIdToField) _csszIdToField.delete(csszId); }
  };
})();
